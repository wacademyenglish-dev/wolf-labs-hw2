/* ══════════════════════════════════════════════════════════════════
   CENAS · THREE PEOPLE, FIVE DAYS · face AURORA
   ══════════════════════════════════════════════════════════════════ */
var CENA={};

/* A ficha fechada mostra a FORMA da frase e esconde só os dados.
   Esconder também a gramática transformaria a pista em ruído. */
function mascara(c){
  var f=String(c.frase);
  [c.name,c.age,c.city].forEach(function(v){
    if(v) f=f.split(v).join('<u class="oco">&nbsp;&nbsp;&nbsp;&nbsp;</u>');
  });
  return f;
}

/* ── o guia do professor ─────────────────────────────────────────── */
CENA.protocol=function(s){
  return LAY({layout:'wide'},'<div class="col mid" style="gap:var(--s5)">'
   +'<div class="hd"><div class="kk"><span class="kick">TEACHER GUIDE</span></div>'
   +'<h2>'+T(s.t)+'</h2><p class="pre en">'+T(s.pre)+'</p></div>'
   +'<div class="bd"><div class="bh"><span class="tag ac">WHAT THEY LEAVE ABLE TO DO</span></div>'
   +'<div class="in"><ol class="obj">'+s.objetivos.map(function(o){
       return '<li><span class="en">'+T(o)+'</span></li>'; }).join('')+'</ol></div></div>'
   +'<p class="como">Press <b>T</b> at any moment for the teacher column. Arrows move between scenes.</p>'
   +'</div>');
};

/* ── I · ABRIR ───────────────────────────────────────────────────
   Foto grande à esquerda, e à direita a pergunta e nada mais.
   O aluno fala nos primeiros noventa segundos. */
CENA.abrir=function(s){
  return LAY(s,
   '<div class="ph">'+(s.foto?'<img src="'+s.foto+'" alt="">':'')
     +(s.cap?'<cap>'+s.cap+'</cap>':'')+'</div>'
  +'<div class="col mid">'
   +HD(s)
   +(s.story?'<p class="story en">'+T(s.story)+'</p>':'')
   +'<div class="bd"><div class="bh"><span class="tag yo">'+s.quem+'</span>'
     +'<span class="sp"></span><span class="tag" id="dc">0 / 3</span></div>'
    +'<div class="in">'+COMO(s)
     +'<div class="dirs">'+s.perguntas.map(function(p,i){
        return '<button class="dq" data-dq="'+i+'"><k>'+String(i+1).padStart(2,'0')+'</k>'
         +'<span class="en">'+T(p.q)+'</span><i>'+T(p.ini)+'</i></button>';
      }).join('')+'</div>'
    +'</div></div>'
   +'<div class="linha"><span class="sp"></span>'+DICA(s.dica)+'</div>'
   +DN(s)+'</div>');
};

/* ── OUVE · ouvir, dizer, e só então ler ─────────────────────────
   A linha escrita NÃO existe até ele tocar. É a regra do método e
   ela tem de ser mecânica, não recomendação. */
CENA.ouve=function(s){
  var lado = s.caras
    ? '<div class="caras">'+s.caras.map(function(c,i){
        return '<figure class="cara" data-cara="'+i+'"><img src="'+c.f+'" alt=""><figcaption>'+c.n+'</figcaption></figure>';
      }).join('')+'</div>'
    : '<div class="ph grow">'+(s.foto?'<img src="'+s.foto+'" alt="">':'')
      +(s.cap?'<cap>'+s.cap+'</cap>':'')+'</div>';
  return LAY(s,
   '<div class="col">'+HD(s)+lado+'</div>'
  +'<div class="col">'
   +'<div class="bd grow"><div class="bh"><span class="tag ac">'+s.rows.length+' LINES</span>'
     +'<span class="sp"></span><span class="tag">SAY IT THREE TIMES</span></div>'
    +'<div class="in">'+COMO(s)+s.rows.map(function(r,i){
      return '<div class="row" data-row="'+i+'"'+(r.cara!=null?' data-liga="'+r.cara+'"':'')+'>'
        +PLAY(r.au,'PLAY','sm')
        +'<button class="ver">tap to read</button>'
        +'<span class="en txt" hidden>'+T(r.en)+'</span></div>';
    }).join('')+'</div></div>'
   +'<div class="linha">'+(s.depois?'<p class="depois"><b>'+T(s.depois)+'</b></p>':'')
     +'<span class="sp"></span>'+DICA(s.dica)+'</div>'
   +DN(s)+'</div>');
};

/* ── PESCA · o vídeo, e depois a devolução ──────────────────────── */
CENA.pesca=function(s){
  return LAY(s,
   '<div class="col mid">'+HD(s)+COMO(s)
    +'<div class="vid"><iframe src="https://www.youtube-nocookie.com/embed/'+s.yt
      +'?start='+s.ini+'&end='+s.fim+'&rel=0&modestbranding=1" title="clip"'
      +' allow="accelerometer;encrypted-media;picture-in-picture" allowfullscreen></iframe></div>'
    +'<div class="linha">'+PLAY(s.au,s.aul,'sm')+'<span class="sp"></span>'+DICA(s.dica)+'</div>'
   +'</div>'
  +'<div class="col">'
   +'<div class="bd grow"><div class="bh"><span class="tag ac">'+s.words.length+' WORDS</span>'
     +'<span class="sp"></span><span class="tag" id="pesc">0 / '+s.words.length+'</span></div>'
    +'<div class="in tiras" id="tiras">'+s.words.map(function(w,i){
       return '<button class="pc tira" data-tira="'+i+'"><span class="en sp">'+T(w)+'</span>'
        +'<span class="ck">\u2713</span></button>';
     }).join('')+'</div></div>'
   +'<div class="linha"><button class="go gh" id="devolve">GIVE THEM BACK \u25b8</button></div>'
   +'<p class="volta" id="volta" hidden><b>'+T(s.volta)+'</b></p>'
   +DN(s)+'</div>');
};

/* ── PESSOAS · a ficha com rosto ────────────────────────────────── */
CENA.pessoas=function(s){
  return LAY(s,'<div class="col">'
   +HD(s)+COMO(s)
   +'<div class="fichas">'+s.cards.map(function(c,i){
     return '<article class="fx'+(c.sua?' sua':'')+'" data-fx="'+i+'">'
      +(c.f?'<div class="fxf"><img src="'+c.f+'" alt=""></div>':'<div class="fxf vaz"><span>'+(c.sua?'YOU':'?')+'</span></div>')
      +'<div class="fxb">'
       +'<k>'+c.n+'</k>'
       +(c.au?PLAY(c.au,'HEAR','sm'):'')
       +(c.sua
          ? '<div class="campos"><span class="cp"><s>name</s><b>&hellip;</b></span>'
            +'<span class="cp"><s>age</s><b>&hellip;</b></span>'
            +'<span class="cp"><s>city</s><b>&hellip;</b></span></div>'
          : '<button class="chk">SAY IT &mdash; THEN CHECK</button>'
            +'<div class="campos" hidden><span class="cp"><s>name</s><b>'+esc(c.name)+'</b></span>'
            +'<span class="cp"><s>age</s><b>'+esc(c.age||c.mudo||'&mdash;')+'</b></span>'
            +'<span class="cp"><s>city</s><b>'+esc(c.city||'&mdash;')+'</b></span></div>')
       +'<p class="fxs en">'+T(c.frase)+'</p>'
       +'<p class="fxm en">'+T(mascara(c))+'</p>'
      +'</div></article>';
   }).join('')+'</div>'
   +'<div class="linha"><span class="sp"></span>'+DICA(s.dica)+'</div>'+DN(s)+'</div>');
};

/* ── ESCADA · a voz dele move o degrau ──────────────────────────── */
CENA.escada=function(s){
  return LAY(s,
   '<div class="col">'+HD(s)
    +'<div class="ph grow">'+(s.foto?'<img src="'+s.foto+'" alt="">':'')
      +(s.cap?'<cap>'+s.cap+'</cap>':'')+'</div>'
    +'</div>'
  +'<div class="col">'
   +'<div class="bd grow"><div class="bh"><span class="tag ac">SAY IT, THEN TAP</span>'
     +'<span class="sp"></span><span class="tag" id="deg">0 / '+s.nums.length+'</span></div>'
    +'<div class="in esc">'+COMO(s)+s.nums.map(function(n,i){
       return '<button class="pc deg" data-deg="'+i+'">'
        +'<b class="num">'+n.n+'</b><span class="en sp">'+n.w+'</span>'
        +'<span class="ck">✓</span></button>';
     }).join('')+'</div></div>'
   +'<div class="linha"><p class="depois" id="voltaesc" hidden><b>'+T(s.volta)+'</b></p>'
     +'<span class="sp"></span>'+DICA(s.dica)+'</div>'
   +DN(s)+'</div>');
};

/* ── ENCONTRO · o andaime que some ──────────────────────────────── */
CENA.encontro=function(s){
  return LAY(s,'<div class="col">'
   +HD(s)+COMO(s)
   +'<div class="rondas">'+s.rounds.map(function(r,i){
     return '<article class="rd rn'+(i===0?' on':'')+'" data-rn="'+i+'">'
      +'<header><i>'+(i+1)+'</i><k>'+r.rot+'</k><span class="sp"></span><s>'+r.papeis+'</s></header>'
      +'<b class="nm">'+r.nome+'</b>'
      +(r.steps.length
         ? '<ol class="steps">'+r.steps.map(function(p){return '<li class="en">'+T(p)+'</li>';}).join('')+'</ol>'
         : '<p class="livre">'+r.semandaime+'</p>')
      +'<button class="go gh mk-feito">DONE ✓</button>'
     +'</article>';
   }).join('')+'</div>'
   +DN(s)+'</div>');
};

/* ── FECHO ──────────────────────────────────────────────────────── */
CENA.clear=function(s){
  return LAY(s,'<div class="col mid" style="gap:var(--s6);text-align:center;align-items:center">'
   +'<i class="selo"></i>'
   +'<h2 class="fim">'+T(s.t)+'</h2>'
   +'<p class="pre en">'+T(s.pre)+'</p>'
   +'<div class="oito">'+s.oito.map(function(o,i){
      return '<span class="oi"><i>'+(i+1)+'</i>'+T(o)+'</span>'; }).join('')+'</div>'
   +'<div class="ct3">'+s.tri.map(function(t){
      return '<div><k>'+t.k+'</k><b>'+t.b+'</b><i>'+t.i+'</i></div>'; }).join('')+'</div>'
   +'</div>');
};
CENA.void=CENA.clear;

/* ── ligações próprias desta aula ───────────────────────────────── */
function conta2(sel,id,tot){
  var n=document.querySelectorAll(sel).length;
  var c=document.getElementById(id); if(c) c.textContent=n+' / '+tot;
  if(n===tot) feito();
}
document.addEventListener('click',function(e){
  /* a pergunta direta da abertura, uma por vez */
  var dq0=e.target.closest && e.target.closest('.dq');
  if(dq0 && !dq0.classList.contains('fez')){
    dq0.classList.add('fez'); conta2('.dq.fez','dc',3); return; }
  /* a ficha: ele diz, e so entao confere */
  var ck0=e.target.closest && e.target.closest('.chk');
  if(ck0){ var fxc=ck0.closest('.fx');
    fxc.querySelector('.campos').hidden=false; fxc.classList.add('vista');
    ck0.remove(); return; }
  var t=e.target;

  /* ouve: a linha só existe depois do toque */
  var v=t.closest('.ver');
  if(v){ var row=v.closest('.row');
    row.querySelector('.txt').hidden=false; v.remove();
    var lg=row.getAttribute('data-liga');
    if(lg!=null){ var c=document.querySelector('[data-cara="'+lg+'"]');
      if(c){ document.querySelectorAll('.cara').forEach(function(x){x.classList.remove('on');});
             c.classList.add('on'); } }
    return; }

  /* pesca */
  var ti=t.closest('.tira');
  if(ti){ ti.classList.toggle('ok');
    var c=document.getElementById('pesc');
    if(c) c.textContent=document.querySelectorAll('.tira.ok').length+' / '+document.querySelectorAll('.tira').length;
    return; }
  if(t.closest('#devolve')){
    document.getElementById('tiras').classList.add('fechado');
    document.getElementById('volta').hidden=false;
    t.closest('#devolve').remove(); return; }

  /* escada */
  var dg=t.closest('.deg');
  if(dg){ dg.classList.add('ok');
    var f=document.querySelectorAll('.deg.ok').length;
    var tot=document.querySelectorAll('.deg').length;
    document.getElementById('deg').textContent=f+' / '+tot;
    if(f===tot){ var vv=document.getElementById('voltaesc'); if(vv) vv.hidden=false; }
    return; }

  /* encontro: uma rodada por vez */
  var fe=t.closest('.mk-feito');
  if(fe){ var a=fe.closest('.rn'); a.classList.add('fez'); a.classList.remove('on');
    var nx=a.nextElementSibling; if(nx) nx.classList.add('on');
    fe.remove(); return; }

  /* ficha: tocar abre */
  var fx=t.closest('.fx');
  if(fx && !t.closest('input') && !t.closest('.pl')){ fx.classList.toggle('ab'); return; }
});

/* o nome dele é guardado e volta nas cenas V e X */
document.addEventListener('input',function(e){

  var c=e.target.getAttribute&&e.target.getAttribute('data-c');
  if(c!=null){ S.d['c'+c+'_'+e.target.getAttribute('data-k')]=e.target.value; grava(); }
});

/* ══════════════════════════════════════════════════════════════════
   CAMADA LOCAL DO PROFESSOR
   A aula publicada é imutável. O que o professor muda vive só no
   navegador dele, como uma CAMADA POR CIMA — nunca por dentro.

        AULA ORIGINAL  +  SOBREPOSIÇÃO LOCAL  =  o que ele vê

   Nada aqui toca o `index.html`, nem a pasta, nem servidor nenhum.
   ══════════════════════════════════════════════════════════════════ */
var LOCAL=(function(){
  var VERSAO=1;
  var CHAVE='wolf-local::'+(window.AULA_ID||'aula');
  var d={v:VERSAO,id:(window.AULA_ID||'aula'),atualizado:null,
         campos:{},extras:{},notas:{}};
  var falhou=false;

  function carrega(){
    try{
      var cru=localStorage.getItem(CHAVE);
      if(!cru) return;
      var o=JSON.parse(cru);
      if(!o||typeof o!=='object') return;
      /* §38 · versão diferente é ignorada com segurança, nunca migra na marra */
      if(o.v!==VERSAO) return;
      d.campos=o.campos||{}; d.extras=o.extras||{}; d.notas=o.notas||{};
      d.atualizado=o.atualizado||null;
    }catch(e){ /* §36 · storage indisponível não apaga nada */ }
  }
  /* §37 · valida antes de gravar; se falhar, o último estado bom fica */
  function grava(){
    var texto;
    try{ d.atualizado=new Date().toISOString(); texto=JSON.stringify(d); }
    catch(e){ aviso('Local edits could not be saved on this device.'); return false; }
    try{ localStorage.setItem(CHAVE,texto); falhou=false; salvou(); return true; }
    catch(e){ falhou=true; aviso('Local edits could not be saved on this device.'); return false; }
  }
  function limpaTudo(){
    d.campos={}; d.extras={}; d.notas={};
    try{ localStorage.removeItem(CHAVE); }catch(e){}
    d.atualizado=null;
  }
  carrega();
  return {
    dados:function(){ return d; },
    campo:function(c){ return Object.prototype.hasOwnProperty.call(d.campos,c)?d.campos[c]:null; },
    poe:function(c,v){ d.campos[c]=v; return grava(); },
    tira:function(c){ delete d.campos[c]; return grava(); },
    extrasDe:function(i){ return d.extras[i]||[]; },
    poeExtra:function(i,q){ (d.extras[i]=d.extras[i]||[]).push(q); return grava(); },
    mudaExtra:function(i,j,q){ if(d.extras[i]&&d.extras[i][j]){ d.extras[i][j]=q; return grava(); } },
    tiraExtra:function(i,j){ if(d.extras[i]){ d.extras[i].splice(j,1);
      if(!d.extras[i].length) delete d.extras[i]; return grava(); } },
    nota:function(i){ return d.notas[i]||''; },
    poeNota:function(i,t){ if(t) d.notas[i]=t; else delete d.notas[i]; return grava(); },
    zera:limpaTudo,
    quantos:function(){ var n=Object.keys(d.campos).length;
      for(var k in d.extras) n+=d.extras[k].length;
      return n+Object.keys(d.notas).length; },
    falhou:function(){ return falhou; }
  };
})();

/* ── ler um caminho dentro do objeto da cena ─────────────────────── */
function leCaminho(o,c){
  var p=c.split('.');
  for(var i=0;i<p.length && o!=null;i++) o=o[p[i]];
  return o;
}
function poeCaminho(o,c,v){
  var p=c.split('.'), a=o;
  for(var i=0;i<p.length-1;i++){ if(a[p[i]]==null) return; a=a[p[i]]; }
  a[p[p.length-1]]=v;
}

/* ── a cena que o professor vê = original + sobreposição ──────────
   O original NUNCA é tocado: isto devolve uma cópia. */
function comLocal(s,i){
  var tem=false, pref=i+'.';
  var campos=LOCAL.dados().campos;
  for(var k in campos) if(k.indexOf(pref)===0){ tem=true; break; }
  var extras=LOCAL.extrasDe(i);
  if(!tem && !extras.length) return s;

  var c=JSON.parse(JSON.stringify(s));
  for(var k2 in campos){
    if(k2.indexOf(pref)!==0) continue;
    var cam=k2.slice(pref.length);
    if(leCaminho(c,cam)===undefined) continue;
    poeCaminho(c,cam,campos[k2]);
  }
  if(extras.length){
    c.hub=c.hub||{t:'WHAT ABOUT YOU?',qs:[]};
    c.hub.qs=(c.hub.qs||[]).concat(extras.map(function(q){
      return {q:q.q,s:q.s||'',pro:1};
    }));
  }
  return c;
}

/* ── o que sai na tela: original é HTML de autor, sobreposição é
      TEXTO PURO escapado (§30). O ~glossário~ continua funcionando. */
function VAL(cam,orig){
  var v=LOCAL.campo(cenaAtual()+'.'+cam);
  if(v==null) return {html:T(orig||''),local:false};
  return {html:T(esc(v)),local:true};
}
function cenaAtual(){ return S.i; }

/* ── marca um pedaço de texto como editável ──────────────────────── */
function ED(cam,orig,tag,cls){
  var r=VAL(cam,orig);
  tag=tag||'span';
  return '<'+tag+' class="'+(cls||'')+(r.local?' temlocal':'')+'"'
    +' data-ed="'+esc(cam)+'">'+r.html+'</'+tag+'>';
}

/* ══ MODO DE EDIÇÃO ═══════════════════════════════════════════════ */
var EDITANDO=false;
function modoEdicao(v){
  EDITANDO=(v===undefined)?!EDITANDO:v;
  document.body.classList.toggle('editando',EDITANDO);
  document.getElementById('bedit').setAttribute('aria-pressed',EDITANDO);
  var pn=document.getElementById('painel');
  pn.classList.toggle('on',EDITANDO);
  if(EDITANDO) pintaPainel(); else fechaCampo();
  pinta();
}

/* o balão de edição de um campo */
var ABERTO=null;
function abreCampo(el){
  fechaCampo();
  var cam=el.getAttribute('data-ed');
  var chave=S.i+'.'+cam;
  var orig=leCaminho(L[S.i],cam);
  var atual=LOCAL.campo(chave);
  var cx=document.createElement('div');
  cx.className='edcx';
  cx.innerHTML=
    '<div class="edh"><k>EDITING · '+esc(cam)+'</k><span class="sp"></span>'
     +'<button class="cb" data-edx aria-label="fechar">&times;</button></div>'
    +'<textarea class="edta" rows="3">'+esc(atual!=null?atual:semTags(orig))+'</textarea>'
    +'<div class="edorig"><k>WOLF LABS ORIGINAL</k><p>'+esc(semTags(orig))+'</p></div>'
    +'<div class="edf"><button class="go" data-edok>SAVE</button>'
     +(atual!=null?'<button class="go gh" data-edreset>RESET THIS CHANGE</button>':'')
     +'<span class="sp"></span><span class="edmsg"></span></div>';
  el.insertAdjacentElement('afterend',cx);
  ABERTO={el:el,cam:cam,cx:cx};
  var ta=cx.querySelector('.edta'); ta.focus(); ta.setSelectionRange(ta.value.length,ta.value.length);
}
function fechaCampo(){ if(ABERTO&&ABERTO.cx&&ABERTO.cx.parentNode) ABERTO.cx.remove(); ABERTO=null; }
/* o original é HTML de autor; no editor ele aparece como texto legível */
function semTags(v){
  return String(v==null?'':v).replace(/<[^>]*>/g,'')
    .replace(/&mdash;/g,'—').replace(/&middot;/g,'·').replace(/&rsquo;/g,'’')
    .replace(/&ldquo;/g,'“').replace(/&rdquo;/g,'”').replace(/&rarr;/g,'→')
    .replace(/&amp;/g,'&').replace(/&nbsp;/g,' ');
}

/* ── o painel: nota, perguntas do professor, e o botão de restaurar ─ */
function pintaPainel(){
  var i=S.i, s=L[i];
  var extras=LOCAL.extrasDe(i);
  var meus=[]; var campos=LOCAL.dados().campos;
  for(var k in campos) if(k.indexOf(i+'.')===0) meus.push(k.slice((i+'.').length));
  document.getElementById('painelin').innerHTML=
     '<p class="pnav">You are editing <b>your local copy</b>. Nothing here changes '
    +'the Wolf Labs lesson, the published file, or another teacher&rsquo;s screen.</p>'
    +'<div class="pnbl"><k>MY NOTE · '+(s.ch||'this scene')+'</k>'
      +'<textarea class="pnnota" rows="2" placeholder="Private. Only you see this.">'
      +esc(LOCAL.nota(i))+'</textarea>'
      +'<s>Private to you. It lives in the TEACHER column, never on the student screen.</s></div>'
    +'<div class="pnbl"><k>MY QUESTIONS</k>'
      +(extras.length?'<ol class="pnqs">'+extras.map(function(q,j){
          return '<li><span>'+esc(q.q)+'</span>'
            +'<button class="cb" data-qdel="'+j+'" title="remover">&times;</button></li>';
        }).join('')+'</ol>':'<p class="pnv">None yet.</p>')
      +'<input class="pnq" placeholder="Add a question for this scene…">'
      +'<s>Added to the WHAT ABOUT YOU hub of this scene, marked as yours.</s></div>'
    +'<div class="pnbl"><k>MY EDITS IN THIS SCENE</k>'
      +(meus.length?'<ul class="pned">'+meus.map(function(c){
          return '<li><b>'+esc(c)+'</b><button class="cb" data-edundo="'+esc(c)+'">reset</button></li>';
        }).join('')+'</ul>':'<p class="pnv">None in this scene.</p>')
      +'</div>'
    +'<div class="pnbl"><k>THIS LESSON</k>'
      +'<p class="pnv">'+LOCAL.quantos()+' local change(s) saved on this computer.</p>'
      +'<button class="go gh" id="pnzera">RESTORE THE ORIGINAL LESSON</button></div>';
}

/* ── avisos ──────────────────────────────────────────────────────── */
var TOAST=null;
function salvou(){ aviso('Saved on this computer.','ok'); }
function aviso(txt,tipo){
  var t=document.getElementById('toast');
  t.textContent=txt; t.className='toast on '+(tipo||'err');
  clearTimeout(TOAST); TOAST=setTimeout(function(){ t.className='toast'; },2200);
}

/* ── ligações ────────────────────────────────────────────────────── */
document.addEventListener('click',function(e){
  var t=e.target;
  if(t.closest('#bedit')){ modoEdicao(); return; }
  if(!EDITANDO) return;

  var alvo=t.closest('[data-ed]');
  if(alvo && !t.closest('.edcx')){ abreCampo(alvo); return; }
  if(t.closest('[data-edx]')){ fechaCampo(); return; }
  if(t.closest('[data-edok]')){
    var v=ABERTO.cx.querySelector('.edta').value.trim();
    var orig=semTags(leCaminho(L[S.i],ABERTO.cam));
    if(v===orig||v===''){ LOCAL.tira(S.i+'.'+ABERTO.cam); } else { LOCAL.poe(S.i+'.'+ABERTO.cam,v); }
    fechaCampo(); pinta(); pintaPainel(); return; }
  if(t.closest('[data-edreset]')){
    LOCAL.tira(S.i+'.'+ABERTO.cam); fechaCampo(); pinta(); pintaPainel(); return; }
  var u=t.closest('[data-edundo]');
  if(u){ LOCAL.tira(S.i+'.'+u.getAttribute('data-edundo')); pinta(); pintaPainel(); return; }
  var qd=t.closest('[data-qdel]');
  if(qd){ LOCAL.tiraExtra(S.i,+qd.getAttribute('data-qdel')); pinta(); pintaPainel(); return; }
  if(t.closest('#pnzera')){
    var b=t.closest('#pnzera');
    if(b.dataset.certeza){ LOCAL.zera(); pinta(); pintaPainel();
      aviso('Original lesson restored.','ok'); return; }
    b.dataset.certeza='1';
    b.textContent='Restore the original Wolf Labs lesson? Your local edits for this lesson will be removed. — CONFIRM';
    setTimeout(function(){ if(b.dataset.certeza){ delete b.dataset.certeza;
      b.textContent='RESTORE THE ORIGINAL LESSON'; } },5000);
    return; }
});
document.addEventListener('keydown',function(e){
  if(!EDITANDO) return;
  if(e.key==='Enter' && e.target.classList.contains('pnq')){
    var v=e.target.value.trim(); if(!v) return;
    LOCAL.poeExtra(S.i,{q:v}); e.target.value=''; pinta(); pintaPainel(); }
});
document.addEventListener('change',function(e){
  if(!EDITANDO) return;
  if(e.target.classList.contains('pnnota')){ LOCAL.poeNota(S.i,e.target.value.trim()); }
});

/* ══════════════════════════════════════════════════════════════════
   NÚCLEO · o que toda aula usa e nenhuma reescreve
   ══════════════════════════════════════════════════════════════════ */
'use strict';

/* ── texto ────────────────────────────────────────────────────────
   ~palavra~ vira uma palavra com pop-up. É a única marcação. */
function T(s){ return G(String(s==null?'':s)); }
function G(s){
  return String(s).replace(/~([^~]+)~/g,function(m,w){
    var k=w.toLowerCase().trim();
    return '<span class="gl" data-gl="'+esc(k)+'" tabindex="0" role="button">'+w+'</span>';
  });
}
function esc(v){ return String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;'); }
function ROM(n){ return ['','I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII','XIII','XIV'][n]||String(n); }
/* baralha uma cópia — a ordem muda a cada abertura, o dado não */
function RTSORTE(a){
  var c=(a||[]).slice();
  for(var i=c.length-1;i>0;i--){ var j=Math.floor(Math.random()*(i+1));
    var t=c[i]; c[i]=c[j]; c[j]=t; }
  return c;
}
function el(h){ var d=document.createElement('div'); d.innerHTML=h.trim(); return d.firstElementChild; }

/* ── estado ───────────────────────────────────────────────────────
   Guardado no aparelho: se o professor recarregar no meio da aula,
   a resposta que o aluno deu no minuto três não se perde. */
var S={i:0,feito:{},d:{}};
var CHAVE='wolf-'+(window.AULA_ID||'x');
try{ var v=localStorage.getItem(CHAVE); if(v) S=Object.assign(S,JSON.parse(v)); }catch(e){}
function grava(){ try{ localStorage.setItem(CHAVE,JSON.stringify(S)); }catch(e){} }

/* ── som ──────────────────────────────────────────────────────────
   Um só toca por vez. O botão sabe se está tocando. */
/* Um áudio por vez, e o MESMO botão pausa e retoma. O professor
   precisa parar no meio de uma frase para repetir uma palavra —
   antes o clique recomeçava do zero e ele perdia o ponto. */
var TOCA=null;
function som(arq,btn){
  if(!arq) return;
  if(TOCA && TOCA.arq===arq){
    if(TOCA.a.paused){ TOCA.a.play(); marcaSom(TOCA.b,'tocando'); }
    else { TOCA.a.pause(); marcaSom(TOCA.b,'pausado'); }
    return;
  }
  if(TOCA){ TOCA.a.pause(); marcaSom(TOCA.b,''); }
  var a=new Audio((window.AUDIO&&window.AUDIO[arq])||('audio/'+arq));
  TOCA={a:a,b:btn,arq:arq};
  marcaSom(btn,'tocando');
  a.onended=a.onerror=function(){ marcaSom(btn,''); if(TOCA&&TOCA.a===a) TOCA=null; };
  a.play().catch(function(){ marcaSom(btn,''); });
}
function marcaSom(btn,estado){
  if(!btn) return;
  btn.classList.toggle('on',estado==='tocando');
  btn.classList.toggle('pausado',estado==='pausado');
  var r=btn.querySelector('.rot');
  if(r) r.textContent = estado==='tocando' ? 'PAUSE'
                      : estado==='pausado' ? 'RESUME'
                      : (btn.getAttribute('data-rot')||'PLAY');
}
var SVGPLAY='<svg class="i-play" viewBox="0 0 24 24"><path d="M7 4v16l13-8z"/></svg>'
  +'<svg class="i-pause" viewBox="0 0 24 24"><path d="M7 4h4v16H7zM13 4h4v16h-4z"/></svg>';
var SVGDICA='<svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-4 12.7V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.3A7 7 0 0 0 12 2zm-2 18h4v1a2 2 0 0 1-4 0v-1z"/></svg>';
/* botão de som com onda — a onda mexe só enquanto toca */
function PLAY(arq,rot,cls){
  var r=(rot===''?'':(rot||'PLAY'));
  return '<button class="pl '+(cls||'')+'" data-au="'+esc(arq||'')+'"'
   +' data-rot="'+esc(r)+'" title="tocar, pausar, retomar">'
   +'<span class="ic">'+SVGPLAY+'</span>'
   +'<span class="wv"><i></i><i></i><i></i><i></i></span>'
   +(r?'<span class="rot">'+r+'</span>':'')+'</button>';
}

/* ── pop-up ───────────────────────────────────────────────────────
   Um só na página. Recebe HTML montado por quem chamou. */
function POP(titulo,html){
  var v=document.getElementById('veu');
  v.querySelector('.pop').innerHTML=
    '<div class="ph"><k>'+(titulo||'')+'</k><span class="sp"></span>'
    +'<button class="x" data-fecha aria-label="fechar">&times;</button></div>'
    +'<div class="pin">'+html+'</div>';
  v.classList.add('on');
  var f=v.querySelector('.x'); if(f) f.focus();
}
function FECHA(){ document.getElementById('veu').classList.remove('on'); }

/* o pop-up de palavra: vem do dicionário da aula */
function POPPAL(k){
  var g=(window.GLOSS||{})[k];
  if(!g){ POP('WORD','<div class="word">'+k+'</div>'); return; }
  POP(g.tp||'WORD',
    '<div class="word">'+(g.w||k)+'</div>'
   +(g.say?'<div class="say">'+g.say+'</div>':'')
   +(g.pt?'<p class="pt">'+g.pt+'</p>':'')
   +(g.d?'<p>'+T(g.d)+'</p>':'')
   +(g.ex?'<div class="ex en">'+T(g.ex)+'</div>':'')
   +(g.no?'<div class="cmp"><div class="bad"><k>NÃO EXISTE</k><div class="en">'+g.no+'</div></div>'
      +'<div class="good"><k>É ASSIM</k><div class="en">'+g.si+'</div></div></div>':''));
}

/* ── TRANSCRIÇÃO ──────────────────────────────────────────────────
   Ela existe, mas NÃO abre sozinha. O método da casa é ouvir, dizer,
   e só então ler: transcrição aberta por padrão apagaria a escuta.
   É um controle do professor, e fica no cromo, longe do conteúdo.

   As linhas saem do arquivo `transcricao.json` da aula quando ele
   existe; quando não existe, saem dos próprios dados da cena — cada
   áudio já mora ao lado da frase que ele diz. */
function linhasDaCena(s){
  var out=[], vistos={};
  (function anda(o){
    if(!o||typeof o!=='object') return;
    if(Array.isArray(o)){ o.forEach(anda); return; }
    var arqs=[], txts=[];
    for(var k in o){
      var v=o[k];
      if(typeof v==='string'){
        if(/\.(mp3|m4a)$/i.test(v)) arqs.push({k:k,v:v});
        else if(v.length>2 && /[a-z]/i.test(v)
             && !/\.(jpe?g|png|webp|gif|svg)$/i.test(v) && v.indexOf('/')<0)
          txts.push({k:k,v:v});
      }
    }
    arqs.forEach(function(a){
      if(vistos[a.v]) return; vistos[a.v]=1;
      var t=(window.TRANSCRICAO&&window.TRANSCRICAO[a.v])||melhorTexto(txts,a.k)||'';
      out.push({arq:a.v,txt:t});
    });
    for(var k2 in o) if(typeof o[k2]==='object') anda(o[k2]);
  })(s);
  return out;
}
/* a frase que o áudio diz é a irmã mais parecida com uma frase */
function melhorTexto(txts,chaveAudio){
  var pref=['en','fr','frase','diz','t','s','f','q','sai','ent'];
  for(var i=0;i<pref.length;i++){
    for(var j=0;j<txts.length;j++) if(txts[j].k===pref[i]) return txts[j].v;
  }
  return txts.length?txts[0].v:'';
}
function POPTRANSC(){
  var ls=linhasDaCena(L[S.i]);
  if(!ls.length){ POP('TRANSCRIPT','<p>No audio in this scene.</p>'); return; }
  POP('TRANSCRIPT &middot; '+(L[S.i].ch||''),
    '<p class="pt">The student should hear it and say it before reading it. '
   +'Open this when it helps, not before.</p>'
   +'<div class="trl">'+ls.map(function(l){
      return '<div class="tr1">'+PLAY(l.arq,'','sm')
        +'<span class="en">'+T(l.txt||'&mdash;')+'</span></div>';
    }).join('')+'</div>');
}

/* ── hub de perguntas pessoais ────────────────────────────────────
   Só aparece onde a cena declara `hub`. Não é painel: é uma aba. */
function HUB(h){
  if(!h) return '';
  return '<div class="hub" id="hub"><button class="hb" data-hub>'
   +'<span>'+(h.t||'WHAT ABOUT YOU?')+'</span><span class="sp"></span>'
   +'<span class="ar">▲</span></button>'
   +'<div class="hin">'+h.qs.map(function(q,i){
      return '<div class="q'+(q.pro?' minha':'')+'"><i>'+(i+1).toString().padStart(2,'0')+'</i>'
        +'<p>'+(q.pro?esc(q.q):ED('hub.qs.'+i+'.q',q.q,'span',''))
        +(q.s?'<s>'+(q.pro?esc(q.s):ED('hub.qs.'+i+'.s',q.s,'span',''))+'</s>':'')
        +(q.pro?'<b class="mk-minha">MINE</b>':'')+'</p></div>';
    }).join('')+'</div></div>';
}

/* ── dica ─────────────────────────────────────────────────────────
   Uma linha. Aparece, e não some sozinha — o professor decide. */
function DICA(txt){
  if(!txt) return '';
  return '<div class="dcw"><button class="dc" data-dica="'+esc(txt)+'">'+SVGDICA+' A HINT</button></div>';
}

/* ── cabeçalho de cena ───────────────────────────────────────────── */
function HD(s){
  return '<div class="hd">'
   +'<div class="kk">'+(s.kick?ED('kick',s.kick,'span','kick'):'')
     +(s.etiq?ED('etiq',s.etiq,'span','tag ac'):'')+'</div>'
   +ED('t',s.t,'h2','')
   +(s.pre?ED('pre',s.pre,'p','pre en'):'')
   +'</div>';
}
/* O ENUNCIADO fica colado no que se faz, nunca no cabeçalho. Uma
   frase curta: se não couber em uma, a cena está errada. */
function COMO(s){
  return s.como?ED('como',s.como,'p','como'):'';
}
function DN(s){
  if(!s.done) return '';
  return '<div class="dn"><k>DONE</k>'+ED('done',s.done,'p','en')+'</div>';
}
function LAY(s,dentro){ return '<div class="L '+(s.layout||'void')+'">'+dentro+'</div>'; }

/* ── navegação ────────────────────────────────────────────────────── */
function vai(n){
  if(n<0||n>=L.length) return;
  S.i=n; grava(); pinta();
  var r=document.querySelector('.rl.on'); if(r) r.scrollIntoView({block:'nearest'});
}
function feito(){ S.feito[S.i]=1; grava(); pintaTrilho(); }

/* desenha a lista das cenas */
function pintaTrilho(){
  var r=document.getElementById('rail');
  r.innerHTML='<b>'+(window.AULA_NOME||'')+'</b>'+L.map(function(s,i){
    var num=s.type==='protocol'?'—':(s.opt?'+':(s.type==='clear'?'✓':ROM(numCena(i))));
    return '<button class="rl'+(i===S.i?' on':'')+(S.feito[i]?' fez':'')
      +(s.opt?' opt':'')+'" data-ir="'+i+'"><i>'+num+'</i><span>'+(s.ch||'')+'</span></button>';
  }).join('');
}
function numCena(i){
  var n=0; for(var j=0;j<=i;j++){ if(L[j].type!=='protocol'&&!L[j].opt&&L[j].type!=='clear') n++; }
  return n;
}

function pinta(){
  var s=comLocal(L[S.i],S.i);      /* original + sobreposição local */
  var st=document.getElementById('stage');
  st.innerHTML='<div class="scene">'+(CENA[s.type]?CENA[s.type](s):CENA.void(s))+'</div>'
    +(s.hub?HUB(s.hub):'');
  st.classList.toggle('temhub',!!s.hub);
  document.getElementById('cena').textContent=
    (s.type==='protocol'?'GUIDE':(s.opt?'EXTRA':ROM(numCena(S.i))))+(s.min?' · '+s.min+' MIN':'');
  var p=0,t=0;
  L.forEach(function(x,i){ if(!x.opt&&x.type!=='protocol'){ t++; if(S.feito[i]) p++; } });
  document.getElementById('barra').style.width=(t?Math.round(p/t*100):0)+'%';
  document.getElementById('conta').textContent=p+' / '+t;
  /* A transcrição não aparece em toda cena com som: só onde a aula
     declara `script:1` — normalmente a cena de listening. */
  var bt=document.getElementById('btrans');
  bt.hidden=!(s.script && linhasDaCena(s).length);
  document.getElementById('ant').disabled=(S.i===0);
  document.getElementById('prox').disabled=(S.i>=L.length-1);
  pintaTrilho(); prof(s);
}

function prof(s){
  var t=s.teacher||{};
  var nota=(typeof LOCAL!=='undefined')?LOCAL.nota(S.i):'';
  document.getElementById('profin').innerHTML=
    (nota?'<div class="blk minhanota"><k>MY NOTE &middot; PRIVATE</k><p>'+esc(nota)+'</p></div>':'')
   +(t.sec?'<div class="av">'+t.sec+'</div>':'')
   +bloco('DO THIS',t.do)+bloco('WATCH FOR',t.watch)
   +bloco('IF THEY ARE STUCK',t.stuck)+bloco('IF THEY ARE STRONG',t.strong);
}
function bloco(k,p){
  if(!p||p==='—') return '';
  return '<div class="blk"><k>'+k+'</k><p>'+T(p)+'</p></div>';
}

/* ── o diário · o que o aluno produziu, para a lousa exportar ────── */
function diario(){
  var o=[]; 
  for(var k in S.d){ if(S.d[k]) o.push({k:k,v:S.d[k]}); }
  return o;
}

/* ── zoom de texto · fica guardado neste computador ─────────────── */
function zoom(v){
  v=Math.min(1.4,Math.max(.8,v));
  document.documentElement.style.setProperty('--zoom',v);
  document.getElementById('zmLbl').textContent=Math.round(v*100)+'%';
  try{ localStorage.setItem('wolf-zoom',v); }catch(e){}
}

/* ── tela cheia ───────────────────────────────────────────────────
   Quem vai para tela cheia é o .app, não o documento: assim a caixa
   em tela cheia é a própria aula e a altura fecha certo. E a classe
   `cheia` segue o estado real do navegador — se o professor sair pelo
   Esc, a barra de cima volta sozinha. */
function cheia(){
  var app=document.getElementById('app');
  if(document.fullscreenElement||document.webkitFullscreenElement){
    (document.exitFullscreen||document.webkitExitFullscreen||function(){}).call(document);
  } else {
    var pede=app.requestFullscreen||app.webkitRequestFullscreen;
    if(pede){ var r=pede.call(app); if(r&&r.catch) r.catch(function(){ marcaCheia(true); }); }
    else marcaCheia(true);   /* navegador sem tela cheia: só esconde o cromo */
  }
}
function marcaCheia(v){
  document.body.classList.toggle('cheia',v);
  document.getElementById('bfull').setAttribute('aria-pressed',v);
}
['fullscreenchange','webkitfullscreenchange'].forEach(function(ev){
  document.addEventListener(ev,function(){
    marcaCheia(!!(document.fullscreenElement||document.webkitFullscreenElement));
  });
});

/* ── A LOUSA (regra 2) ──────────────────────────────────────────── */
var LOUSA=(function(){
  var K='wolf-lousa-'+(window.AULA_ID||'x');
  var el,ta,sc,sv,t=null;
  function pronto(){
    el=document.getElementById('lousa'); ta=document.getElementById('ltxt');
    sc=document.getElementById('lscrim'); sv=document.getElementById('lsalvo');
    try{ ta.value=localStorage.getItem(K)||''; }catch(e){}
    ta.addEventListener('input',salva);
  }
  function salva(){
    try{ localStorage.setItem(K,ta.value); }catch(e){}
    sv.classList.add('on'); clearTimeout(t);
    t=setTimeout(function(){ sv.classList.remove('on'); },1400);
  }
  function abre(v){
    el.classList.toggle('on',v); sc.classList.toggle('on',v);
    if(v) setTimeout(function(){ ta.focus(); },150);
  }
  function etiqueta(tg){
    var tag=(tg==='SCENE'?'[SCENE '+(S.i)+'] ':'['+tg+'] ');
    var p=ta.selectionStart,v=ta.value;
    var nl=(p>0&&v[p-1]!=='\n')?'\n':'';
    ta.value=v.slice(0,p)+nl+tag+v.slice(p);
    ta.focus(); ta.selectionStart=ta.selectionEnd=p+nl.length+tag.length; salva();
  }
  function inteiro(){
    var d=diario();
    var j=d.length?'\n\n--- WHAT THE STUDENT DID ---\n'+d.map(function(x){return '\u00b7 '+x.k+': '+x.v;}).join('\n'):'';
    return (window.AULA_TITULO||'')+' \u2014 '+(window.AULA_NIVEL||'')+' \u2014 '+new Date().toLocaleDateString()+'\n'
      +'Scene '+S.i+' of '+(L.length-1)+'\n\n'
      +((ta.value||'').trim()||'(no notes)')+j+'\n';
  }
  return {pronto:pronto,abre:abre,etiqueta:etiqueta,inteiro:inteiro,
    aberta:function(){return el&&el.classList.contains('on');},
    limpa:function(){ta.value='';salva();}};
})();

/* ── luz ──────────────────────────────────────────────────────────── */
function luz(v){
  document.documentElement.setAttribute('data-luz',v);
  try{ localStorage.setItem('wolf-luz',v); }catch(e){}
  var b=document.getElementById('bluz');
  b.setAttribute('aria-pressed',v==='dia');
  b.querySelector('span').textContent=v==='dia'?'DIA':'NOITE';
}

/* ── ligações ─────────────────────────────────────────────────────── */
document.addEventListener('click',function(e){
  var t=e.target;
  var a=t.closest('[data-au]');   if(a){ som(a.getAttribute('data-au'),a); return; }
  var g=t.closest('[data-gl]');   if(g){ POPPAL(g.getAttribute('data-gl')); return; }
  var ir=t.closest('[data-ir]');  if(ir){ vai(+ir.getAttribute('data-ir')); fechaRail(); return; }
  var h=t.closest('[data-hub]');  if(h){ h.parentNode.classList.toggle('on'); return; }
  var d=t.closest('[data-dica]'); if(d){
    var p=document.createElement('p'); p.className='dctx';
    p.innerHTML=T(d.getAttribute('data-dica'));
    d.parentNode.replaceChild(p,d); return; }
  if(t.closest('[data-fecha]')||t.id==='veu'){ FECHA(); return; }
  if(t.closest('#prox')){ feito(); vai(S.i+1); return; }
  if(t.closest('#ant')){ vai(S.i-1); return; }
  if(t.closest('#bprof')){ var pr=document.getElementById('prof');
    pr.classList.toggle('on');
    document.getElementById('bprof').setAttribute('aria-pressed',pr.classList.contains('on')); return; }
  if(t.closest('#bluz')){ luz(document.documentElement.getAttribute('data-luz')==='dia'?'noite':'dia'); return; }
  if(t.closest('#btrans')){ POPTRANSC(); return; }
  if(t.closest('#brail')){ abreTrilho(); return; }
  if(t.closest('#zmMenos')){ zoom(zAtual()-.05); return; }
  if(t.closest('#zmMais')){ zoom(zAtual()+.05); return; }
  if(t.closest('#bfull')){ cheia(); return; }
  if(t.closest('#blousa')){ LOUSA.abre(!LOUSA.aberta()); return; }
  if(t.closest('#lfecha')||t.id==='lscrim'){ LOUSA.abre(false); return; }
  var tg=t.closest('.ltg'); if(tg){ LOUSA.etiqueta(tg.getAttribute('data-t')); return; }
  if(t.closest('#lcopy')){ var b=t.closest('#lcopy');
    navigator.clipboard.writeText(LOUSA.inteiro()).then(function(){
      b.textContent='Copied'; setTimeout(function(){b.textContent='Copy';},1600); })
      .catch(function(){ document.getElementById('ltxt').select(); }); return; }
  if(t.closest('#ldl')){
    var bl=new Blob([LOUSA.inteiro()],{type:'text/plain;charset=utf-8'});
    var a=document.createElement('a'); a.href=URL.createObjectURL(bl);
    a.download=(window.AULA_ID||'aula')+'-notes.txt'; a.click();
    setTimeout(function(){URL.revokeObjectURL(a.href);},2000); return; }
  if(t.closest('#lclear')){ var lc=t.closest('#lclear');
    if(lc.dataset.certeza){ LOUSA.limpa(); delete lc.dataset.certeza; lc.textContent='Clear'; return; }
    lc.dataset.certeza='1'; lc.textContent='Sure?';
    setTimeout(function(){ delete lc.dataset.certeza; lc.textContent='Clear'; },2600); return; }
});
/* ☰ · abre e fecha a lista das cenas.
   ATENÇÃO: esta função NÃO pode se chamar trilho(). Já existe uma
   pintaTrilho() que desenha a lista, e uma segunda declaração com o
   mesmo nome apaga a primeira em silêncio — foi assim que a coluna
   passou a abrir vazia. */
function abreTrilho(v){
  var r=document.getElementById('rail');
  if(innerWidth<=860){ r.classList.toggle('on'); return; }
  var b=r.parentNode;
  var fora = (v===undefined) ? !b.classList.contains('recolhido') : v;
  b.classList.toggle('recolhido',fora);
  document.getElementById('brail').setAttribute('aria-pressed',fora);
  try{ localStorage.setItem('wolf-trilho',fora?'0':'1'); }catch(e){}
}
function zAtual(){ var v=parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--zoom')); return v||1; }
document.addEventListener('keydown',function(e){
  if(e.key==='Escape'){ FECHA(); return; }
  if(e.key==='Enter'||e.key===' '){
    var g=document.activeElement&&document.activeElement.closest&&document.activeElement.closest('[data-gl]');
    if(g){ e.preventDefault(); POPPAL(g.getAttribute('data-gl')); }
  }
  if(e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA') return;
  if(e.key==='ArrowRight'){ feito(); vai(S.i+1); }
  if(e.key==='ArrowLeft'){ vai(S.i-1); }
  if(e.key==='t'||e.key==='T'||e.key==='g'||e.key==='G'){ document.getElementById('bprof').click(); }
  if(e.key==='b'||e.key==='B'){ document.getElementById('blousa').click(); }
  if(e.key==='f'||e.key==='F'){ document.getElementById('bfull').click(); }
  if(e.key==='s'||e.key==='S'){ document.getElementById('brail').click(); }
  if(e.key==='l'||e.key==='L'){ document.getElementById('bluz').click(); }
});
function fechaRail(){ if(innerWidth<=860) document.getElementById('rail').classList.remove('on'); }

/* ── partida ──────────────────────────────────────────────────────── */
(function(){
  var l='noite'; try{ l=localStorage.getItem('wolf-luz')||'noite'; }catch(e){}
  luz(l);
  var z=1; try{ z=parseFloat(localStorage.getItem('wolf-zoom'))||1; }catch(e){}
  zoom(z);
  /* a aula começa com a lista FECHADA: o professor partilha a tela e
     o que ele quer ver primeiro é a cena, não o índice. */
  var aberto='0'; try{ aberto=localStorage.getItem('wolf-trilho')||'0'; }catch(e){}
  if(innerWidth>860) abreTrilho(aberto!=='1');
  LOUSA.pronto();
  if(S.i>=L.length) S.i=0;
  pinta();
})();
</script>
</body>
</html>
