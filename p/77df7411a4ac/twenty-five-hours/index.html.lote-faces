<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>WOLF LABS · Twenty-Five Hours</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;700&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>/* ══════════════════════════════════════════════════════════════════
   WOLF LABS · CHASSI 2026 · TOKENS
   Um esqueleto. Duas luzes (noite e dia). Cinco faces.
   Nada de cor literal fora deste arquivo e do 20-faces.
   ══════════════════════════════════════════════════════════════════ */
*{box-sizing:border-box}
[hidden]{display:none!important}
/* A altura vem de html → body → .app em porcentagem, NUNCA de 100vh.
   Em tela cheia o Chrome não recalcula vh de forma confiável quando o
   elemento em tela cheia é o documento: a aula ficava com a altura da
   janela antiga e sobrava metade da tela preta embaixo. */
html{height:100%;font-size:calc(clamp(16px,.28vw + 10.8px,19px) * var(--zoom,1))}
body{margin:0;overflow:hidden;height:100%;-webkit-font-smoothing:antialiased;
  background:var(--bg);color:var(--t1);font-family:var(--ui)}

:root{
  /* ── tipografia ────────────────────────────────────────────────
     O inglês é serifado. A ferramenta é grotesca. O dado é mono.
     A separação carrega a distinção conteúdo/programa sem explicar. */
  --ui:'Plus Jakarta Sans',system-ui,-apple-system,sans-serif;
  --se:'Newsreader',Georgia,serif;
  --di:'Archivo',system-ui,sans-serif;
  --mo:'JetBrains Mono',ui-monospace,monospace;
  --ci:'Instrument Serif',Georgia,serif;
  --lh-t:1.04; --lh-q:1.28; --lh-b:1.58;
  --ls-t:-.024em; --ls-l:.19em;

  /* ── espaço · passos de 4, sem meio-termo ─────────────────────── */
  --s1:6px; --s2:10px; --s3:14px; --s4:18px;
  --s5:22px; --s6:28px; --s7:36px; --s8:48px;

  /* ── forma ─────────────────────────────────────────────────────
     O cromo não tem raio. A placa tem. A peça tem menos. */
  --r-plate:14px; --r-well:10px; --r-piece:7px; --r-pill:999px;

  /* ── alvo, foco, movimento ─────────────────────────────────────── */
  --target:44px;
  --m-cromo:120ms linear;
  --m-peca:180ms cubic-bezier(.2,.8,.2,1);
  --m-cena:360ms cubic-bezier(.22,.75,.2,1);

  /* ── a marca ────────────────────────────────────────────────────
     O lobo é CROMO, não é voz. Ele é dourado porque a marca é
     dourada; o âmbar do professor continua sendo outra coisa e
     nunca aparece do lado dele. */
  --mark:url('img/mark-gold.png');

  /* ── tinta SOBRE FOTO · não muda com a luz, porque a foto não muda ── */
  --on-photo:#fff;
  --on-photo-2:rgba(255,255,255,.86);
  --on-photo-3:rgba(255,255,255,.64);
}

/* ══ NOITE · o padrão. Nunca #000: 4–7% de luminância, com matiz. ══ */
:root,[data-luz="noite"]{
  --bg:#080B12; --bg2:#0B1018;
  --s-1:rgba(255,255,255,.038);
  --s-2:rgba(255,255,255,.062);
  --s-3:rgba(255,255,255,.092);
  --plate:rgba(255,255,255,.048);
  --ln:rgba(255,255,255,.10);
  --ln2:rgba(255,255,255,.19);
  --edge:rgba(255,255,255,.14);        /* o brilho de 1px no topo do vidro */
  --t1:#E9EDF4; --t2:#A7B2C4; --t3:#6E7A8D;
  --sh1:0 2px 8px rgba(0,0,0,.42);
  --sh2:0 1px 0 rgba(255,255,255,.07) inset,0 6px 18px rgba(0,0,0,.5);
  --sh3:0 1px 0 rgba(255,255,255,.06) inset,0 22px 52px rgba(0,0,0,.58);
  --scrim:linear-gradient(transparent 26%,rgba(4,6,11,.9) 88%);
  /* três vozes cromáticas, medidas sobre #080B12 */
  --v-ac:#4FC8FF;   /* AÇÃO · o que reage ao toque      11.4:1 */
  --v-yo:#5FE3B0;   /* A FALA DO ALUNO                  12.9:1 */
  --v-pr:#E9B872;   /* O PROFESSOR                      10.6:1 */
  --v-ok:#5FE3B0; --v-er:#FF8B84; --v-wa:#F2C078;
  --v-ac-ink:#03202E; --v-yo-ink:#022018; --v-pr-ink:#241703;
  --v-ac-fio:rgba(79,200,255,.32); --v-ac-vidro:rgba(79,200,255,.10);
  --v-yo-fio:rgba(95,227,176,.32); --v-yo-vidro:rgba(95,227,176,.09);
  --v-pr-fio:rgba(233,184,114,.30); --v-pr-vidro:rgba(233,184,114,.08);
  color-scheme:dark;
}

/* ══ DIA · nunca #FFF. Papel morno, 3–5% abaixo do branco. ══════════
   Não é a noite invertida: os pesos mudam, as vozes trocam de matiz
   (a menta some no claro, entra magenta) e a sombra vira fio. */
[data-luz="dia"]{
  --bg:#E9EAEE; --bg2:#E2E4EA;
  --s-1:rgba(255,255,255,.62);
  --s-2:rgba(255,255,255,.82);
  --s-3:#FBFBFD;
  --plate:#F6F7FA;
  --ln:rgba(16,26,44,.13);
  --ln2:rgba(16,26,44,.26);
  --edge:rgba(255,255,255,.9);
  --t1:#121826; --t2:#454F62; --t3:#78829400;
  --t3:#767F91;
  --sh1:0 1px 2px rgba(16,26,44,.10);
  --sh2:0 1px 3px rgba(16,26,44,.10),0 6px 16px rgba(16,26,44,.07);
  --sh3:0 2px 6px rgba(16,26,44,.10),0 20px 44px rgba(16,26,44,.10);
  --scrim:linear-gradient(transparent 26%,rgba(10,14,24,.86) 88%);
  --v-ac:#0B5FC4;   /* medidas sobre #E9EAEE */
  --v-yo:#A2246B;
  --v-pr:#7A4A08;
  --v-ok:#0E7A52; --v-er:#B3261E; --v-wa:#8A5A00;
  --v-ac-ink:#fff; --v-yo-ink:#fff; --v-pr-ink:#fff;
  --v-ac-fio:rgba(11,95,196,.30); --v-ac-vidro:rgba(11,95,196,.07);
  --v-yo-fio:rgba(162,36,107,.28); --v-yo-vidro:rgba(162,36,107,.06);
  --v-pr-fio:rgba(122,74,8,.28);  --v-pr-vidro:rgba(122,74,8,.06);
  --mark:url('img/mark-gold-light.png');
  color-scheme:light;
}

@media (prefers-reduced-motion:reduce){
  *{animation-duration:.001ms!important;transition-duration:.001ms!important}
}

/* ══════════════════════════════════════════════════════════════════
   AS CINCO FACES
   Uma face muda TRÊS coisas e mais nada:
     1. o campo (o fundo e a sua atmosfera)
     2. o material da superfície (vidro · sólido · papel · placa)
     3. a cor da AÇÃO
   As outras duas vozes — a fala do aluno e o professor — NÃO mudam
   de face nenhuma, para o aluno aprender uma vez que verde é a vez
   dele e âmbar é o professor, e isso valer no produto inteiro.
   ══════════════════════════════════════════════════════════════════ */

/* ─── AURORA · vidro sobre azul-noite ────────────────────────────
   O azul e o branco-quebrado da Wolf Academy levados a sério. O campo
   é atmosfera e não se move. O vidro é UMA camada, com fio de 10% e
   brilho interno de 1px no topo — é a aresta que separa vidro caro de
   vidro barato, não o borrão. */
.f-aurora{
  --v-ac:#4FC8FF; --v-ac-ink:#03202E;
  --v-ac-fio:rgba(79,200,255,.32); --v-ac-vidro:rgba(79,200,255,.10);
  --mat:var(--plate); --mat-fio:var(--ln); --mat-sh:var(--sh2);
  --mat-edge:inset 0 1px 0 var(--edge);
  --blur:saturate(1.25) blur(14px);
  --r-plate:14px;
  background:
   radial-gradient(58vw 42vh at 17% 6%,rgba(79,200,255,.10),transparent 62%),
   radial-gradient(52vw 40vh at 87% 94%,rgba(142,155,255,.11),transparent 60%),
   radial-gradient(70vw 52vh at 50% 122%,rgba(95,227,176,.045),transparent 60%),
   linear-gradient(#080B12,#0A1120 58%,#080B12);
}
[data-luz="dia"] .f-aurora{
  --v-ac:#0B5FC4; --v-ac-ink:#fff;
  --v-ac-fio:rgba(11,95,196,.30); --v-ac-vidro:rgba(11,95,196,.07);
  --mat:var(--s-3); --mat-fio:var(--ln); --mat-sh:var(--sh2);
  --mat-edge:none; --blur:none;
  background:
   radial-gradient(58vw 42vh at 17% 4%,rgba(11,95,196,.11),transparent 62%),
   radial-gradient(52vw 40vh at 87% 96%,rgba(83,97,216,.08),transparent 60%),
   linear-gradient(#EDEEF2,#E6E8EE 60%,#EDEEF2);
}

/* ─── MESA · a bancada ───────────────────────────────────────────
   A aula não é uma página: é uma superfície com objetos em cima.
   Malha de pontos, peças com sombra CURTA e real, nada de vidro.
   O gesto principal é MOVER. */
.f-mesa{
  --v-ac:#8AA6FF; --v-ac-ink:#0A1230;
  --v-ac-fio:rgba(138,166,255,.34); --v-ac-vidro:rgba(138,166,255,.10);
  --mat:#25231F; --mat-fio:rgba(237,234,226,.13); --mat-sh:0 2px 0 rgba(0,0,0,.45);
  --mat-edge:none; --blur:none;
  --r-plate:10px; --r-piece:6px;
  --t1:#EFEBE2; --t2:#AFA99C; --t3:#7C766B;
  --ln:rgba(237,234,226,.13); --ln2:rgba(237,234,226,.27);
  background:
   radial-gradient(circle at 1px 1px,rgba(237,234,226,.11) 1px,transparent 0) 0 0/22px 22px,
   linear-gradient(#1B1A18,#201F1C);
}
[data-luz="dia"] .f-mesa{
  --v-ac:#2646C8; --v-ac-ink:#fff;
  --v-ac-fio:rgba(38,70,200,.30); --v-ac-vidro:rgba(38,70,200,.07);
  --mat:#FCFAF5; --mat-fio:rgba(27,26,23,.14); --mat-sh:0 1px 0 rgba(27,26,23,.14),0 3px 8px rgba(27,26,23,.08);
  --t1:#1B1A17; --t2:#4F4B43; --t3:#8A8478;
  --ln:rgba(27,26,23,.14); --ln2:rgba(27,26,23,.28);
  background:
   radial-gradient(circle at 1px 1px,rgba(27,26,23,.15) 1px,transparent 0) 0 0/22px 22px,
   #E8E3D8;
}

/* ─── PALCO · a sala escura ──────────────────────────────────────
   Uma ideia por corte. A imagem é o CHÃO da tela inteira e o texto
   vive onde vive a legenda de cinema. Duas tarjas carregam o cromo.
   O dourado aqui NÃO é voz: é moldura. A voz do professor continua
   sendo âmbar e continua tendo o mesmo papel. */
.f-palco{
  --v-ac:#6FD0F5; --v-ac-ink:#02202C;
  --v-ac-fio:rgba(111,208,245,.32); --v-ac-vidro:rgba(111,208,245,.10);
  --mat:rgba(255,255,255,.055); --mat-fio:rgba(255,255,255,.11);
  --mat-sh:0 20px 60px rgba(0,0,0,.6); --mat-edge:inset 0 1px 0 rgba(255,255,255,.10);
  --blur:saturate(1.1) blur(10px);
  --tarja:#000; --moldura:#D8B87C;
  --di:'Instrument Serif',Georgia,serif;
  --bg:#06070A;
  background:radial-gradient(78vw 56vh at 50% 44%,#0F1218,#06070A 74%);
}
[data-luz="dia"] .f-palco{
  /* a sala escura NÃO fica branca: ela acende as paredes e mantém o
     palco. Inverter esta face seria destruí-la. */
  --v-ac:#0B5FC4; --v-ac-ink:#fff;
  --mat:rgba(255,255,255,.92); --mat-fio:rgba(16,26,44,.12);
  --mat-sh:var(--sh2); --mat-edge:none; --blur:none;
  --tarja:#15171C; --moldura:#8A6A2E;
  --bg:#DEDFE4;
  background:radial-gradient(78vw 56vh at 50% 44%,#EAEBEF,#DEDFE4 74%);
}

/* ─── VIOLETA · o produto de butique ─────────────────────────────
   A única face onde o canto redondo é grande, e ela existe para
   provar que redondo pode ser adulto. Nada de vidro: superfícies
   SÓLIDAS tingidas de violeta em quatro degraus, com um halo lilás
   muito difuso atrás do conteúdo. */
.f-violeta{
  --v-ac:#B79CFF; --v-ac-ink:#150C2E;
  --v-ac-fio:rgba(183,156,255,.34); --v-ac-vidro:rgba(183,156,255,.11);
  --mat:#211934; --mat-fio:rgba(183,156,255,.16); --mat-sh:0 10px 30px rgba(0,0,0,.45);
  --mat-edge:none; --blur:none;
  --r-plate:20px; --r-well:14px; --r-piece:10px;
  --di:'Fraunces',Georgia,serif;
  --t1:#F0EBF8; --t2:#B7ACCE; --t3:#8177A0;
  --ln:rgba(183,156,255,.16); --ln2:rgba(183,156,255,.30);
  --bg:#120E1C;
  background:
   radial-gradient(62vw 44vh at 50% 108%,rgba(183,156,255,.17),transparent 66%),
   radial-gradient(46vw 34vh at 7% -9%,rgba(227,167,232,.11),transparent 62%),
   #120E1C;
}
[data-luz="dia"] .f-violeta{
  --v-ac:#6134CF; --v-ac-ink:#fff;
  --v-ac-fio:rgba(97,52,207,.28); --v-ac-vidro:rgba(97,52,207,.07);
  --mat:#FFFFFF; --mat-fio:rgba(60,40,110,.13); --mat-sh:0 2px 8px rgba(60,40,110,.10);
  --t1:#1C1630; --t2:#524868; --t3:#83789D;
  --ln:rgba(60,40,110,.13); --ln2:rgba(60,40,110,.26);
  --bg:#F2EFF9;
  background:
   radial-gradient(62vw 44vh at 50% 110%,rgba(97,52,207,.12),transparent 66%),
   radial-gradient(46vw 34vh at 7% -9%,rgba(168,69,180,.07),transparent 62%),
   #F2EFF9;
}

/* ─── ESTÚDIO · o dossiê ─────────────────────────────────────────
   Cromo de ferramenta: trilho de evidência à esquerda, inspetor à
   direita, régua no pé. MAS a placa central é de aula, não de
   ferramenta — a direção 15 pontuou 4 em ALUNO no catálogo, e é
   exatamente aqui que esse defeito se conserta. */
.f-estudio{
  --v-ac:#5AA6FF; --v-ac-ink:#03192E;
  --v-ac-fio:rgba(90,166,255,.32); --v-ac-vidro:rgba(90,166,255,.10);
  --mat:#181C22; --mat-fio:rgba(255,255,255,.09); --mat-sh:0 6px 18px rgba(0,0,0,.44);
  --mat-edge:inset 0 1px 0 rgba(255,255,255,.05); --blur:none;
  --r-plate:10px;
  --cromo:#13161A; --cromo2:#1D2128;
  --t1:#EDF0F4; --t2:#A4ACB7; --t3:#6C7581;
  --ln:rgba(255,255,255,.085); --ln2:rgba(255,255,255,.17);
  --bg:#0E1013;
  background:linear-gradient(#0E1013,#111419);
}
[data-luz="dia"] .f-estudio{
  --v-ac:#0B5FC4; --v-ac-ink:#fff;
  --mat:#FFFFFF; --mat-fio:rgba(10,16,24,.12); --mat-sh:var(--sh2); --mat-edge:none;
  --cromo:#E4E7EC; --cromo2:#EDEFF3;
  --t1:#0F141A; --t2:#495360; --t3:#7D8794;
  --ln:rgba(10,16,24,.11); --ln2:rgba(10,16,24,.20);
  --bg:#E7E9ED;
  background:linear-gradient(#E7E9ED,#E1E4E9);
}

/* ══════════════════════════════════════════════════════════════════
   SALA · a galeria                              (direcao 05 do catalogo)
   Uma ideia por parede. O espaco negativo e estrutura, nao sobra: a
   foto e o objeto, e o texto e ETIQUETA DE MUSEU — bloco pequeno,
   alinhado a esquerda, ao lado da peca, nunca por cima dela.
   A direcao nasceu clara (parede de galeria). Aqui a NOITE e a mesma
   sala com a luz baixa, que e o que o catalogo ja previa — e nao um
   claro invertido. Sem vidro, sem sombra difusa: parede e moldura.
   ══════════════════════════════════════════════════════════════════ */
.f-sala{
  --v-ac:#7FB4D4; --v-ac-ink:#08202E;
  --v-ac-fio:rgba(127,180,212,.30); --v-ac-vidro:rgba(127,180,212,.09);
  --mat:#211F1C; --mat-fio:rgba(237,233,225,.14); --mat-sh:0 1px 0 rgba(0,0,0,.4);
  --mat-edge:none; --blur:none;
  --r-plate:2px; --r-well:2px; --r-piece:2px;
  --cromo:#141311; --cromo2:#1C1A18;
  --t1:#EDE9E1; --t2:#A6A199; --t3:#726D65;
  --ln:rgba(237,233,225,.13); --ln2:rgba(237,233,225,.26);
  --bg:#1A1917;
  --moldura:#D5B074;
  --campo:radial-gradient(120% 80% at 50% 8%,rgba(255,247,232,.045),transparent 60%),
          linear-gradient(#1A1917,#151412);
  background:var(--campo);
}
[data-luz="dia"] .f-sala{
  --v-ac:#14425C; --v-ac-ink:#fff;
  --v-ac-fio:rgba(20,66,92,.30); --v-ac-vidro:rgba(20,66,92,.07);
  --mat:#F4F1EA; --mat-fio:rgba(27,26,24,.16); --mat-sh:0 1px 0 rgba(27,26,24,.08);
  --cromo:#E5E0D6; --cromo2:#EDE9E1;
  --t1:#1B1A18; --t2:#55524C; --t3:#8E8A82;
  --ln:rgba(27,26,24,.13); --ln2:rgba(27,26,24,.24);
  --bg:#EDE9E1;
  --moldura:#9A7B3F;
  --campo:radial-gradient(120% 80% at 50% 6%,rgba(255,255,255,.55),transparent 60%),
          linear-gradient(#EDE9E1,#E5E0D6);
  background:var(--campo);
}

/* ══════════════════════════════════════════════════════════════════
   PROJETO · o desenho tecnico                   (direcao 04 do catalogo)
   Papel milimetrado, cantos de registro, linhas de chamada, escala.
   A regra da direcao e dura: nenhuma explicacao em paragrafo, tudo e
   DIAGRAMA COM LEGENDA. Numa aula de dizer as horas isso cai certo,
   porque o mostrador ja e um desenho cotado — o angulo do ponteiro e a
   medida, e a legenda e a frase em ingles.
   Ciano de heliografica na acao, ambar so no cromo do professor.
   ══════════════════════════════════════════════════════════════════ */
.f-projeto{
  --v-ac:#21C6D6; --v-ac-ink:#03222A;
  --v-ac-fio:rgba(33,198,214,.32); --v-ac-vidro:rgba(33,198,214,.09);
  --mat:#0E1B2A; --mat-fio:rgba(130,200,225,.20); --mat-sh:0 2px 0 rgba(0,0,0,.4);
  --mat-edge:inset 0 1px 0 rgba(160,215,235,.05); --blur:none;
  --r-plate:3px; --r-well:3px; --r-piece:2px;
  --cromo:#091320; --cromo2:#101F30;
  --t1:#DCE9F2; --t2:#93AEC2; --t3:#5F7C93;
  --ln:rgba(130,200,225,.17); --ln2:rgba(130,200,225,.34);
  --bg:#0A1420;
  --gr:rgba(120,190,220,.055); --gr2:rgba(120,190,220,.11);
  --grafite:#9EC3D8;
  --campo:
    repeating-linear-gradient(0deg,var(--gr) 0 1px,transparent 1px 9px),
    repeating-linear-gradient(90deg,var(--gr) 0 1px,transparent 1px 9px),
    repeating-linear-gradient(0deg,var(--gr2) 0 1px,transparent 1px 45px),
    repeating-linear-gradient(90deg,var(--gr2) 0 1px,transparent 1px 45px),
    linear-gradient(160deg,#0B1724,#0A1420 55%,#08111B);
  background:var(--campo);
}
[data-luz="dia"] .f-projeto{
  --v-ac:#0A6E7A; --v-ac-ink:#fff;
  --v-ac-fio:rgba(10,110,122,.30); --v-ac-vidro:rgba(10,110,122,.07);
  --mat:#FCFDFE; --mat-fio:rgba(14,44,64,.17); --mat-sh:0 1px 0 rgba(14,44,64,.10);
  --mat-edge:none;
  --cromo:#E2E9ED; --cromo2:#ECF1F4;
  --t1:#0B1A26; --t2:#3F586B; --t3:#748A99;
  --ln:rgba(14,44,64,.14); --ln2:rgba(14,44,64,.26);
  --bg:#E8EEF1;
  --gr:rgba(20,80,110,.06); --gr2:rgba(20,80,110,.12);
  --grafite:#33556B;
  --campo:
    repeating-linear-gradient(0deg,var(--gr) 0 1px,transparent 1px 9px),
    repeating-linear-gradient(90deg,var(--gr) 0 1px,transparent 1px 9px),
    repeating-linear-gradient(0deg,var(--gr2) 0 1px,transparent 1px 45px),
    repeating-linear-gradient(90deg,var(--gr2) 0 1px,transparent 1px 45px),
    linear-gradient(160deg,#EAF0F3,#E8EEF1 55%,#E3EAEE);
  background:var(--campo);
}

/* ══════════════════════════════════════════════════════════════════
   CROMO · a moldura que não muda de aula nenhuma
   Tela fixa, rolagem só dentro do tabuleiro. O professor nunca rola
   no meio de uma explicação e o aluno nunca perde o enunciado.
   ══════════════════════════════════════════════════════════════════ */
/* o CAMPO da face pinta aqui. Ate agora `background:var(--bg)` tapava
   qualquer campo com camadas (a malha da PLANTA sumia inteira): o .app
   cobre a tela toda e vem depois na cascata. Face sem campo continua
   caindo em --bg, entao nada muda para as cinco antigas. */
.app{height:100%;width:100%;max-width:100%;display:grid;
  grid-template-rows:auto 1fr auto;overflow:hidden;
  background:var(--campo,var(--bg))}
/* a própria aula vai para tela cheia — não o documento */
.app:fullscreen,.app:-webkit-full-screen{width:100%;height:100%;background:var(--bg)}

/* ── barra de cima ───────────────────────────────────────────────
   min-height, nunca height: uma barra de altura fixa com overflow
   hidden corta as letras pela metade quando o zoom sobe ou quando
   alguém captura a página inteira. Ela cresce em vez de cortar. */
.top{display:flex;align-items:center;gap:var(--s3);padding:var(--s1) var(--s5);
  min-width:0;overflow-x:clip;overflow-y:visible;flex-wrap:wrap;
  min-height:46px;flex:0 0 auto;border-bottom:1px solid var(--ln);
  background:color-mix(in srgb,var(--bg) 78%,transparent);
  backdrop-filter:var(--blur,none);position:relative;z-index:30}
/* ── A MARCA · o bloco de identidade ──────────────────────────────
   Lobo + palavra juntos, e um fio separando da aula. É a única coisa
   da barra que não é controle: por isso ela tem o seu próprio bloco
   e a sua própria borda, e o resto encosta nela. */
.marca{display:inline-flex;align-items:center;gap:10px;flex:0 0 auto;
  padding-right:var(--s4);border-right:1px solid var(--ln);margin-right:2px;
  text-decoration:none}
.top .mk{width:27px;height:27px;background:var(--mark) center/contain no-repeat;
  flex:0 0 auto;filter:drop-shadow(0 1px 2px rgba(0,0,0,.35))}
[data-luz="dia"] .top .mk{filter:none}
.top .nm{display:flex;flex-direction:column;line-height:1.05}
.top .nm b{font-family:var(--mo);font-size:.72rem;letter-spacing:.3em;
  font-weight:700;color:var(--t1);white-space:nowrap}
.top .nm s{text-decoration:none;font-family:var(--mo);font-size:.5rem;
  letter-spacing:.24em;color:var(--v-ac);white-space:nowrap}
.top .ti{font-family:var(--se);font-size:.98rem;color:var(--t1);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;flex:1}
.top .sp{flex:1 1 auto;min-width:0}
.tag{font-family:var(--mo);font-size:.6rem;letter-spacing:.16em;font-weight:600;
  padding:3px 8px;border-radius:var(--r-pill);border:1px solid var(--ln2);
  color:var(--t2);white-space:nowrap}
.tag.ac{color:var(--v-ac);border-color:var(--v-ac-fio);background:var(--v-ac-vidro)}
.tag.yo{color:var(--v-yo);border-color:var(--v-yo-fio);background:var(--v-yo-vidro)}
.tag.pr{color:var(--v-pr);border-color:var(--v-pr-fio);background:var(--v-pr-vidro)}

/* botão de cromo — 44px de alvo real, desenho de 28 */
.cb{width:var(--target);height:36px;display:inline-flex;align-items:center;
  justify-content:center;gap:6px;background:none;border:1px solid transparent;
  border-radius:8px;color:var(--t2);cursor:pointer;font-family:var(--mo);
  font-size:.62rem;letter-spacing:.14em;transition:var(--m-cromo);padding:0 8px}
.cb.w{width:auto;min-width:var(--target)}
.cb:hover{color:var(--t1);border-color:var(--ln2);background:var(--s-1)}
.cb:focus-visible{outline:2px solid var(--v-ac);outline-offset:2px}
.cb svg{width:16px;height:16px;fill:currentColor}
.cb[aria-pressed="true"]{color:var(--v-ac);border-color:var(--v-ac-fio);background:var(--v-ac-vidro)}

/* ── corpo: trilho · palco ────────────────────────────────────── */
.body{position:relative;display:grid;grid-template-columns:190px minmax(0,1fr);
  min-width:0;min-height:0;overflow:hidden;
  transition:grid-template-columns 180ms cubic-bezier(.22,.75,.2,1)}
/* o trilho recolhe no computador também — ele partilha a tela e às
   vezes quer a cena inteira. A classe vai NO PRÓPRIO .body: assim a
   coluna vira zero de verdade, e não uma faixa vazia. */
.body.recolhido{grid-template-columns:0 minmax(0,1fr)}
/* o trilho continua NA GRADE com largura zero. Tirá-lo com display:none
   empurraria o palco para a primeira coluna — que é justamente a de
   zero — e a cena sumiria. */
.body.recolhido > .rail{overflow:hidden;border-right:0;opacity:0;pointer-events:none}
.rail{border-right:1px solid var(--ln);overflow:hidden auto;padding:var(--s3) 0;
  transition:opacity 140ms;
  background:color-mix(in srgb,var(--bg) 60%,transparent);display:flex;flex-direction:column;gap:2px}
.rail b{display:block;font-family:var(--mo);font-size:.56rem;letter-spacing:.2em;
  color:var(--t3);padding:var(--s2) var(--s4) var(--s1)}
.rl{display:grid;grid-template-columns:26px 1fr;align-items:baseline;gap:var(--s2);
  padding:9px var(--s4);border:0;border-left:2px solid transparent;background:none;
  text-align:left;cursor:pointer;color:var(--t2);font-family:var(--ui);font-size:.78rem;
  transition:var(--m-cromo);width:100%;min-height:38px}
.rl i{font-family:var(--mo);font-size:.58rem;font-style:normal;color:var(--t3);letter-spacing:.08em}
.rl:hover{background:var(--s-1);color:var(--t1)}
.rl.on{border-left-color:var(--v-ac);background:var(--v-ac-vidro);color:var(--t1);font-weight:600}
.rl.on i{color:var(--v-ac)}
.rl.fez i::after{content:' ✓';color:var(--v-ok)}
.rl.opt{opacity:.62}
.rl:focus-visible{outline:2px solid var(--v-ac);outline-offset:-2px}

.stage{min-width:0;min-height:0;overflow:hidden;position:relative;display:flex}
.scene{flex:1 1 0;min-width:0;min-height:0;max-width:100%;display:flex;flex-direction:column;
  animation:ent var(--m-cena) both}
@keyframes ent{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

/* ── rodapé ───────────────────────────────────────────────────── */
.foot{display:flex;align-items:center;gap:var(--s3);height:56px;padding:0 var(--s5);min-width:0;overflow:hidden;
  border-top:1px solid var(--ln);flex:0 0 auto;
  background:color-mix(in srgb,var(--bg) 78%,transparent);backdrop-filter:var(--blur,none)}
.bar{flex:1;height:3px;border-radius:2px;background:var(--s-2);overflow:hidden;min-width:60px}
.bar i{display:block;height:100%;background:var(--v-ac);transition:width var(--m-cena)}
.foot .ct{font-family:var(--mo);font-size:.62rem;letter-spacing:.13em;color:var(--t3);white-space:nowrap}

/* o botão de avançar: a única coisa dourada do rodapé é a AÇÃO */
.go{display:inline-flex;align-items:center;gap:9px;min-height:var(--target);
  padding:0 var(--s5);border-radius:var(--r-pill);border:1px solid var(--v-ac-fio);
  background:var(--v-ac);color:var(--v-ac-ink);font-family:var(--mo);font-weight:700;
  font-size:.68rem;letter-spacing:.15em;cursor:pointer;transition:var(--m-peca);
  box-shadow:var(--sh1)}
.go:hover{filter:brightness(1.08);transform:translateY(-1px)}
.go:active{transform:none}
.go:focus-visible{outline:2px solid var(--t1);outline-offset:3px}
.go.gh{background:none;color:var(--t2);border-color:var(--ln2);box-shadow:none;font-weight:600}
.go.gh:hover{color:var(--t1);border-color:var(--v-ac-fio);filter:none}
.go[disabled]{opacity:.34;cursor:default;transform:none;filter:none}

/* ── gaveta do professor ───────────────────────────────────────
   Fechada por padrão. Ele partilha a tela no Meet: nada que seja
   dele aparece sem que ele mande aparecer. */
.prof{position:absolute;inset:0 0 0 auto;width:min(400px,42vw);z-index:40;
  background:var(--bg2);border-left:1px solid var(--ln2);box-shadow:var(--sh3);
  transform:translateX(101%);transition:transform 240ms cubic-bezier(.22,.75,.2,1);
  display:flex;flex-direction:column;overflow:hidden}
.prof.on{transform:none}
.prof h4{margin:0;padding:var(--s4) var(--s5);border-bottom:1px solid var(--ln);
  font-family:var(--mo);font-size:.62rem;letter-spacing:.18em;color:var(--v-pr);
  display:flex;align-items:center;gap:var(--s2)}
.prof h4 .sp{flex:1}
.prof .in{padding:var(--s5);overflow-y:auto;display:flex;flex-direction:column;gap:var(--s5)}
.prof .blk{display:flex;flex-direction:column;gap:6px}
.prof .blk k{font-family:var(--mo);font-size:.56rem;letter-spacing:.19em;color:var(--v-pr)}
.prof .blk p{margin:0;font-size:.86rem;line-height:var(--lh-b);color:var(--t2)}
.prof .blk p b{color:var(--t1)}
.prof .av{font-size:.68rem;color:var(--t3);border-top:1px solid var(--ln);padding-top:var(--s3);
  font-family:var(--mo);letter-spacing:.1em}

/* ── celular: a composição não encolhe, ela muda ───────────────── */
@media (max-width:860px){
  .body{grid-template-columns:minmax(0,1fr)}
  .rail{position:absolute;inset:0 auto 0 0;width:220px;z-index:35;background:var(--bg2);
    border-right:1px solid var(--ln2);box-shadow:var(--sh3);
    transform:translateX(-101%);transition:transform 220ms}
  .rail.on{transform:none}
  .top{height:44px;padding:0 var(--s3);gap:var(--s2)}
  .top .ti{font-size:.86rem}
  .foot{height:auto;min-height:56px;padding:var(--s2) var(--s3);flex-wrap:wrap}
  .prof{width:100%}
  .top .zm,.top #bedit,.top #bfull,.top #blousa{display:none}
  .top{flex-wrap:nowrap;gap:var(--s1)}
  .top .ti{font-size:.82rem}
  .top .tag:not(#cena){display:none}
  .top .nm s{display:none}
  .marca{padding-right:var(--s2);border-right:0}
}

/* ── zoom de texto ──────────────────────────────────────────────── */
.zm{display:inline-flex;align-items:center;gap:2px}
.zm b{font-family:var(--mo);font-size:.58rem;letter-spacing:.08em;color:var(--t3);min-width:2.6rem;
  text-align:center}
.zm .cb{width:30px;min-width:30px;padding:0;font-size:.9rem}

/* ── A LOUSA · cromo do professor, e o aluno nunca vê ─────────────
   Ela existe desde a regra 2 da casa e continua igual: as etiquetas,
   o texto que salva sozinho, e a exportação com o que o aluno fez. */
.lscrim{position:fixed;inset:0;background:rgba(3,5,9,.55);z-index:70;display:none}
.lscrim.on{display:block}
.lousa{position:fixed;top:0;right:0;bottom:0;width:min(430px,92vw);z-index:75;
  background:var(--bg2);border-left:1px solid var(--ln2);box-shadow:var(--sh3);
  display:none;flex-direction:column;padding:var(--s5);gap:var(--s3)}
.lousa.on{display:flex}
.lousa .lh{display:flex;align-items:center;gap:var(--s2)}
.lousa .lh h3{margin:0;font-family:var(--di);font-weight:700;font-size:1.06rem;color:var(--t1)}
.lousa .lh .sp{flex:1}
.salvo{font-family:var(--mo);font-size:.58rem;letter-spacing:.14em;color:var(--v-ok);
  opacity:0;transition:opacity var(--m-cromo)}
.salvo.on{opacity:1}
.ltags{display:flex;flex-wrap:wrap;gap:var(--s1)}
.ltg{min-height:36px;padding:0 var(--s3);border:1px solid var(--ln2);border-radius:var(--r-pill);
  background:none;font-family:var(--mo);font-size:.62rem;letter-spacing:.1em;color:var(--t2);cursor:pointer}
.ltg:hover{border-color:var(--v-pr-fio);color:var(--v-pr);background:var(--v-pr-vidro)}
.ltxt{flex:1;min-height:180px;width:100%;padding:var(--s3);border:1px solid var(--ln2);
  border-radius:var(--r-well);background:var(--bg);color:var(--t1);font-family:var(--ui);
  font-size:.94rem;line-height:1.6;resize:none}
.ltxt:focus{outline:none;border-color:var(--v-pr)}
.lf{display:flex;gap:var(--s2);flex-wrap:wrap}
.lf .go{min-height:38px;padding:0 var(--s4);font-size:.62rem}

/* ── TELA CHEIA · o conteúdo cresce, o cromo encolhe ──────────────
   Nenhum elemento novo entra: só somem os que não são a aula. */
/* ATENÇÃO · terceira vez que este erro aparece hoje:
   `display:none` num item de grade TIRA O ITEM DA GRADE e empurra os
   vizinhos para as trilhas de trás. Aqui a barra sumia, o palco caía na
   trilha `auto` e o rodapé na `1fr` — a aula ficava com a altura do
   conteúdo e sobrava meia tela preta embaixo.
   A barra continua na grade, com altura zero. */
body.cheia .app{grid-template-rows:0 1fr auto}
body.cheia .top{height:0;min-height:0;padding:0;border:0;overflow:hidden;
  opacity:0;pointer-events:none}
body.cheia .body{border-top:3px solid var(--v-ac)}
body.cheia .body{grid-template-columns:0 minmax(0,1fr)}
body.cheia .rail{overflow:hidden;opacity:0;pointer-events:none;border-right:0}
body.cheia .L{padding:var(--s7) var(--s8)}
body.cheia .hd h2{font-size:clamp(1.9rem,3.4vw,3.1rem)}
body.cheia .en{font-size:1.06em}

/* ── RETRATO · uma tela mais alta do que larga não é uma tela de aula.
   Acontece em tablet em pé, em captura de página inteira, e em janela
   estreita. Em vez de esticar a foto até virar coluna, a cena empilha
   e a foto ganha teto. */
@media (max-aspect-ratio: 5/4){
  .L,.L.split,.L.imgcon,.L.dossier,.L.wide{
    grid-template-columns:minmax(0,1fr)!important;
    grid-auto-rows:min-content;align-content:safe center;overflow-y:auto}
  .L.void{place-items:safe center stretch}
  .col,.col.mid{min-height:auto;justify-content:flex-start}
  .grow{flex:0 0 auto}
  .bd{min-height:auto}
  .bd > .in{overflow-y:visible}
  .ph{aspect-ratio:16/9;max-height:34vh;min-height:0}
  .L.dossier .dl,.L.dossier .dr{display:none}
}

/* qual arquivo é este · fica no pé da coluna do professor */
.carimbo{margin-top:auto;padding:var(--s3) var(--s5);border-top:1px solid var(--ln);
  font-family:var(--mo);font-size:.56rem;letter-spacing:.14em;color:var(--t3)}

/* ── A BARRA EM TELA ESTREITA ──────────────────────────────────────
   Em 430px a barra somava 448px e o `overflow-x:clip` cortava: os
   rotulos apareciam montados uns nos outros ("SCRIPTNOITEACHER").
   O que sai sao as ETIQUETAS de cena (nivel, minutos, SCRIPT) — elas
   sao informacao do professor e ele tem tudo isso na coluna dele e no
   trilho. Os botoes e a marca ficam. */
@media (max-width:520px){
  .top > .tag,.top .ti{display:none}
}

/* ══════════════════════════════════════════════════════════════════
   COMPONENTES · o vocabulário de peças que toda aula usa
   ══════════════════════════════════════════════════════════════════ */

/* ── LAYOUTS ────────────────────────────────────────────────────
   Composição horizontal, conteúdo centrado, área grande. Nada de
   coluna estreita no meio e nada de margem gigante. */
.L{flex:1;min-height:0;display:grid;padding:var(--s6) var(--s7);gap:var(--s6)}
.L.void{place-items:center;grid-template-columns:minmax(0,1fr);overflow-y:auto}
.L.void > *{max-width:60rem;width:100%}
.L.split{grid-template-columns:minmax(0,.86fr) minmax(0,1.14fr);align-items:stretch}
.L.wide{grid-template-columns:minmax(0,1fr);overflow-y:auto}
.L.wide > *{max-width:74rem;width:100%;justify-self:center}
.L.imgcon{grid-template-columns:minmax(0,1.06fr) minmax(0,.94fr);align-items:center}
/* A foto do imgcon guarda a proporção em que foi feita e fica centrada
   na coluna. Esticar a caixa até a altura toda obrigava o object-fit a
   comer as laterais — foi o que cortou a estação de Londres. */
.L.imgcon > .ph{aspect-ratio:16/9;height:auto;max-height:100%;align-self:center}
.L.cinema{padding:0;grid-template-columns:minmax(0,1fr)}
.L.dossier{grid-template-columns:15rem minmax(0,1fr) 17rem;gap:var(--s5)}
@media (max-width:1180px){
  .L.dossier{grid-template-columns:minmax(0,1fr)}
  .L.dossier .dl,.L.dossier .dr{display:none}
}
/* ── A DOBRA · abaixo de 1000 a tela deixa de ser fixa e vira pilha.
   A ordem é sempre a mesma: cabeçalho, fonte, tabuleiro, ação. ─────── */
@media (max-width:1000px){
  .L{padding:var(--s4) var(--s5);gap:var(--s4);
     grid-template-columns:minmax(0,1fr)!important;grid-auto-rows:min-content;
     overflow-y:auto;align-content:safe center}
  .L.void{place-items:safe center stretch}
  .col,.col.mid{min-height:auto;justify-content:flex-start}
  .grow{flex:0 0 auto}
  .bd{min-height:auto}
  .bd > .in{overflow-y:visible}
  .ph{aspect-ratio:16/10;min-height:0}
}
.col{display:flex;flex-direction:column;min-width:0;min-height:0;gap:var(--s4)}
.col.mid{justify-content:center}
.grow{flex:1 1 auto;min-height:0}

/* ── CABEÇALHO DE CENA ──────────────────────────────────────────
   O título, e UMA frase de enunciado. O §03 do prompt é lei aqui:
   o enunciado ideal é uma frase curta. Se não couber em uma, a cena
   está errada, não o cabeçalho. */
.hd{display:flex;flex-direction:column;gap:var(--s2);flex:0 0 auto}
.hd .kk{display:flex;align-items:center;gap:var(--s2);flex-wrap:wrap}
.hd .kick{font-family:var(--mo);font-size:.58rem;letter-spacing:.24em;color:var(--v-ac)}
.hd h2{margin:0;font-family:var(--di);font-weight:700;letter-spacing:var(--ls-t);
  line-height:var(--lh-t);font-size:clamp(1.5rem,2.6vw,2.5rem);color:var(--t1)}
.f-violeta .hd h2,.f-palco .hd h2{font-weight:400}
.hd .como{margin:0;font-size:.92rem;line-height:1.5;color:var(--t2);max-width:46rem}
.hd .como b{color:var(--t1);font-weight:600}
.hd .pre{margin:0;font-family:var(--se);font-size:1.02rem;line-height:1.5;
  color:var(--t2);max-width:44rem;font-style:italic}

/* ── TODO INGLÊS É SERIFADO ─────────────────────────────────────── */
.en{font-family:var(--se);line-height:var(--lh-q)}
.en b,.en strong{font-weight:600;color:var(--t1)}
.g{color:var(--v-ac);font-weight:600}
.mk{color:var(--v-ac);font-weight:600}

/* ── TABULEIRO ─────────────────────────────────────────────────── */
.bd{background:var(--mat);border:1px solid var(--mat-fio);border-radius:var(--r-plate);
  box-shadow:var(--mat-sh),var(--mat-edge,none);backdrop-filter:var(--blur,none);
  display:flex;flex-direction:column;min-height:0;overflow:hidden}
.bd > .bh{display:flex;align-items:center;gap:var(--s2);padding:var(--s3) var(--s4);
  border-bottom:1px solid var(--ln);flex:0 0 auto}
.bd > .bh .sp{flex:1}
.bd > .in{padding:var(--s4);overflow-y:auto;min-height:0;display:flex;
  flex-direction:column;gap:var(--s3);flex:1 1 auto}
.bd.flush > .in{padding:0}

/* ── PEÇA · o que se toca ───────────────────────────────────────
   Regra da casa: FIO PARA LER, SOMBRA PARA MEXER. Se tem sombra,
   move ou responde. Se é só fio, é para ler. */
.pc{display:flex;align-items:center;gap:var(--s3);min-height:var(--target);
  padding:var(--s2) var(--s4);border-radius:var(--r-piece);border:1px solid var(--ln);
  background:var(--s-1);color:var(--t1);font-family:var(--se);font-size:1rem;
  line-height:1.35;text-align:left;cursor:pointer;transition:var(--m-peca);
  box-shadow:var(--sh1);width:100%}
.pc:hover{border-color:var(--v-ac-fio);background:var(--v-ac-vidro);transform:translateY(-1px)}
.pc:focus-visible{outline:2px solid var(--v-ac);outline-offset:2px}
.pc.on{border-color:var(--v-ac);background:var(--v-ac-vidro);box-shadow:var(--sh2)}
.pc.ok{border-color:var(--v-ok);background:color-mix(in srgb,var(--v-ok) 12%,transparent)}
.pc.no{border-color:var(--v-er);background:color-mix(in srgb,var(--v-er) 12%,transparent);
  animation:shk 260ms}
@keyframes shk{0%,100%{transform:none}25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
.pc[disabled]{opacity:.42;cursor:default;box-shadow:none;transform:none}
.pc .n{font-family:var(--mo);font-size:.6rem;letter-spacing:.12em;color:var(--t3);flex:0 0 auto}
.pc .sp{flex:1}

/* peça só de leitura — fio, sem sombra */
.rd{border:1px solid var(--ln);border-radius:var(--r-piece);padding:var(--s3) var(--s4);
  background:none;box-shadow:none;font-family:var(--se);line-height:var(--lh-q);color:var(--t2)}
.rd b{color:var(--t1)}

/* ── ZONA · o lugar onde a peça cai ─────────────────────────────── */
.zn{border:1px dashed var(--ln2);border-radius:var(--r-well);padding:var(--s3);
  display:flex;flex-direction:column;gap:var(--s2);min-height:5rem;background:var(--s-1);
  transition:var(--m-peca)}
.zn.aim{border-color:var(--v-ac);background:var(--v-ac-vidro);border-style:solid}
.zn .zh{display:flex;flex-direction:column;gap:2px}
.zn .zh k{font-family:var(--mo);font-size:.56rem;letter-spacing:.2em;color:var(--v-ac)}
.zn .zh n{font-family:var(--di);font-weight:700;font-size:.94rem;color:var(--t1)}
.zn .zh s{text-decoration:none;font-size:.74rem;color:var(--t3);font-family:var(--mo);letter-spacing:.06em}
.zn .zo{font-size:.8rem;color:var(--t3);line-height:1.45}

/* ── BOTÃO DE SOM · elegante, e a mão vê o estado ────────────────── */
.pl{display:inline-flex;align-items:center;gap:var(--s2);min-height:var(--target);
  padding:0 var(--s4) 0 6px;border-radius:var(--r-pill);border:1px solid var(--ln2);
  background:var(--s-1);color:var(--t1);cursor:pointer;font-family:var(--mo);
  font-size:.63rem;letter-spacing:.14em;transition:var(--m-peca)}
.pl .ic{width:32px;height:32px;border-radius:50%;background:var(--v-ac);color:var(--v-ac-ink);
  display:grid;place-items:center;flex:0 0 auto;transition:var(--m-peca)}
.pl .ic svg{width:14px;height:14px;fill:currentColor}
.pl .i-play{margin-left:1px} .pl .i-pause{display:none}
.pl.on .i-play,.pl.pausado .i-play{display:none}
.pl.on .i-pause{display:block;margin:0}
.pl.pausado .i-pause{display:none}
.pl.pausado .i-play{display:block;margin-left:1px}
.pl:hover{border-color:var(--v-ac-fio);background:var(--v-ac-vidro)}
.pl:hover .ic{transform:scale(1.06)}
.pl:focus-visible{outline:2px solid var(--v-ac);outline-offset:2px}
.pl.on .ic{background:var(--v-ok);color:var(--v-yo-ink)}
.pl.pausado{border-color:var(--v-wa)}
.pl.pausado .ic{background:var(--v-wa);color:var(--v-ac-ink)}
.pl.pausado .wv i{background:var(--v-wa);height:4px;animation:none}
.pl .wv{display:flex;align-items:center;gap:2px;height:14px}
.pl .wv i{width:2px;background:var(--t3);border-radius:1px;height:4px}
.pl.on .wv i{background:var(--v-ok);animation:wv 900ms ease-in-out infinite}
.pl.on .wv i:nth-child(2){animation-delay:120ms}
.pl.on .wv i:nth-child(3){animation-delay:240ms}
.pl.on .wv i:nth-child(4){animation-delay:80ms}
@keyframes wv{0%,100%{height:4px}50%{height:14px}}
.pl.sm{min-height:36px;font-size:.58rem;padding:0 var(--s3) 0 5px}
.pl.sm .ic{width:26px;height:26px}

/* ── BOTÃO DE DICA · uma linha, e some ───────────────────────────
   Ela é do ALUNO. Por isso não tem a cor da ação: tem a dele. */
.dc{display:inline-flex;align-items:center;gap:7px;min-height:36px;padding:0 var(--s3);
  border-radius:var(--r-pill);border:1px dashed var(--v-yo-fio);background:none;
  color:var(--v-yo);font-family:var(--mo);font-size:.6rem;letter-spacing:.14em;
  cursor:pointer;transition:var(--m-peca)}
.dc:hover{background:var(--v-yo-vidro);border-style:solid}
.dc:focus-visible{outline:2px solid var(--v-yo);outline-offset:2px}
.dc svg{width:13px;height:13px;fill:currentColor}
.dctx{font-size:.84rem;line-height:1.5;color:var(--v-yo);border-left:2px solid var(--v-yo-fio);
  padding-left:var(--s3);margin:0;animation:ent 200ms both}

/* ── HUB FLUTUANTE · WHAT ABOUT YOU? ─────────────────────────────
   Fica no pé, fechado, e SÓ em cenas onde acrescenta conversa. Não
   é painel: é uma aba que sobe. */
.hub{position:absolute;left:50%;bottom:0;transform:translateX(-50%);z-index:25;
  width:min(52rem,calc(100% - 3rem));display:flex;flex-direction:column;
  border:1px solid var(--v-yo-fio);border-bottom:0;
  border-radius:var(--r-plate) var(--r-plate) 0 0;
  background:color-mix(in srgb,var(--bg2) 94%,var(--v-yo) 6%);
  box-shadow:0 -10px 34px rgba(0,0,0,.32);backdrop-filter:var(--blur,none);
  transition:transform 220ms cubic-bezier(.22,.75,.2,1)}
.hub .hb{display:flex;align-items:center;gap:var(--s2);min-height:42px;padding:0 var(--s4);
  border:0;background:none;color:var(--v-yo);font-family:var(--mo);font-size:.63rem;
  letter-spacing:.18em;cursor:pointer;width:100%;text-align:left}
.hub .hb .sp{flex:1}
.hub .hb .ar{transition:var(--m-peca)}
.hub.on .hb .ar{transform:rotate(180deg)}
.hub .hin{display:none;padding:0 var(--s5) var(--s5);flex-direction:column;gap:var(--s3)}
.hub.on .hin{display:flex}
.hub .q{display:flex;gap:var(--s3);align-items:baseline}
.hub .q i{font-family:var(--mo);font-size:.58rem;color:var(--v-yo);font-style:normal;flex:0 0 auto}
.hub .q p{margin:0;font-family:var(--se);font-size:1.02rem;line-height:1.4;color:var(--t1)}
.hub .q s{display:block;text-decoration:none;font-family:var(--ui);font-size:.8rem;
  color:var(--t3);margin-top:3px}
@media (max-width:860px){.hub{width:calc(100% - 1rem)}}

/* o hub sobe por cima: a cena abre espaço para ele, nunca fica coberta */
.stage.temhub .L{padding-bottom:calc(var(--s6) + 52px)}

/* ── POP-UP · elegância, vidro, e SEMPRE leve ────────────────────
   Não abre porque fica bonito. Abre quando explicar ali economiza
   uma tela inteira. */
.veu{position:fixed;inset:0;z-index:60;background:rgba(3,5,9,.62);
  backdrop-filter:blur(3px);display:none;place-items:center;padding:var(--s5);
  animation:fade 160ms both}
.veu.on{display:grid}
@keyframes fade{from{opacity:0}to{opacity:1}}
.pop{width:min(40rem,100%);max-height:min(80vh,42rem);display:flex;flex-direction:column;
  border-radius:var(--r-plate);border:1px solid var(--ln2);
  background:color-mix(in srgb,var(--bg2) 92%,transparent);
  box-shadow:var(--sh3),inset 0 1px 0 var(--edge);backdrop-filter:saturate(1.3) blur(20px);
  animation:pin 200ms cubic-bezier(.22,.75,.2,1) both;overflow:hidden}
@keyframes pin{from{opacity:0;transform:translateY(14px) scale(.985)}to{opacity:1;transform:none}}
.pop .ph{display:flex;align-items:center;gap:var(--s2);padding:var(--s4) var(--s5);
  border-bottom:1px solid var(--ln)}
.pop .ph k{font-family:var(--mo);font-size:.58rem;letter-spacing:.2em;color:var(--v-ac)}
.pop .ph .sp{flex:1}
.pop .ph .x{width:34px;height:34px;border-radius:8px;border:1px solid transparent;
  background:none;color:var(--t3);cursor:pointer;font-size:1.1rem;line-height:1}
.pop .ph .x:hover{color:var(--t1);border-color:var(--ln2);background:var(--s-1)}
.pop .pin{padding:var(--s5);overflow-y:auto;display:flex;flex-direction:column;gap:var(--s4)}
.pop .word{font-family:var(--se);font-size:1.7rem;line-height:1.1;color:var(--t1)}
.pop .say{font-family:var(--mo);font-size:.72rem;letter-spacing:.06em;color:var(--v-ac)}
.pop p{margin:0;font-size:.94rem;line-height:var(--lh-b);color:var(--t2)}
.pop p b{color:var(--t1)}
.pop .ex{font-family:var(--se);font-size:1.06rem;line-height:1.4;color:var(--t1);
  border-left:2px solid var(--v-ac-fio);padding-left:var(--s4)}
.pop .pt{font-size:.86rem;color:var(--t3);font-style:italic}
.pop .cmp{display:grid;grid-template-columns:1fr 1fr;gap:var(--s3)}
.pop .cmp > div{border:1px solid var(--ln);border-radius:var(--r-well);padding:var(--s3)}
.pop .cmp k{display:block;font-family:var(--mo);font-size:.56rem;letter-spacing:.18em;
  color:var(--t3);margin-bottom:5px}
.pop .cmp .bad k{color:var(--v-er)} .pop .cmp .good k{color:var(--v-ok)}
.pop .cmp .en{font-size:1rem}
.pop .cmp .bad .en{text-decoration:line-through;text-decoration-color:var(--v-er);color:var(--t3)}
@media (max-width:640px){.pop .cmp{grid-template-columns:1fr}}

/* palavra com pop-up: pontilhado por baixo, e o cursor diz */
.gl{border-bottom:1px dashed var(--v-ac-fio);cursor:help;color:inherit}
.gl:hover{border-bottom-style:solid;color:var(--v-ac)}

/* ── RESPOSTA REVELADA ──────────────────────────────────────────── */
.rev{border-left:2px solid var(--v-ac-fio);padding-left:var(--s4);
  display:flex;flex-direction:column;gap:5px;animation:ent 200ms both}
.rev k{font-family:var(--mo);font-size:.56rem;letter-spacing:.2em;color:var(--v-ac)}
.rev p{margin:0;font-size:.88rem;line-height:1.55;color:var(--t2)}
.rev .en{font-size:1.06rem;color:var(--t1)}

/* ── FOTO ───────────────────────────────────────────────────────── */
.ph{position:relative;border-radius:var(--r-plate);overflow:hidden;min-height:0;
  background:var(--s-1);border:1px solid var(--ln)}
.ph img{width:100%;height:100%;object-fit:cover;display:block}
.ph cap{position:absolute;left:0;right:0;bottom:0;padding:var(--s5) var(--s4) var(--s3);
  background:var(--scrim);color:var(--on-photo-2);font-family:var(--mo);
  font-size:.6rem;letter-spacing:.16em}
.ph.sq{aspect-ratio:1}
.ph.wd{aspect-ratio:16/10}

/* ── MOLDE / ANDAIME · o que o aluno pode dizer ─────────────────── */
.md{display:flex;flex-wrap:wrap;gap:var(--s2)}
.md span{font-family:var(--se);font-size:.94rem;color:var(--v-yo);
  border:1px dashed var(--v-yo-fio);border-radius:var(--r-pill);padding:5px var(--s3)}

/* ── FECHO DA CENA ─────────────────────────────────────────────── */
.dn{display:flex;align-items:baseline;gap:var(--s3);border-top:1px solid var(--ln);
  padding-top:var(--s3);flex:0 0 auto}
.dn k{font-family:var(--mo);font-size:.56rem;letter-spacing:.2em;color:var(--v-ok);flex:0 0 auto}
.dn p{margin:0;font-family:var(--se);font-size:.98rem;line-height:1.4;color:var(--t2)}

/* ── PLACAR / CONTADOR ─────────────────────────────────────────── */
.ct3{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--s4)}
.ct3 > div{display:flex;flex-direction:column;gap:3px;text-align:center}
.ct3 k{font-family:var(--mo);font-size:.56rem;letter-spacing:.2em;color:var(--t3)}
.ct3 b{font-family:var(--di);font-size:2.4rem;line-height:1;color:var(--v-ac)}
.ct3 i{font-style:normal;font-size:.78rem;color:var(--t3)}

/* ── a transcrição no pop-up ─────────────────────────────────────── */
.trl{display:flex;flex-direction:column;gap:var(--s2)}
.tr1{display:flex;align-items:center;gap:var(--s3);padding-bottom:var(--s2);
  border-bottom:1px solid var(--ln)}
.tr1:last-child{border-bottom:0}
.tr1 .en{font-size:1.06rem;line-height:1.35;color:var(--t1)}

/* ── SOMBRA DE ROLAGEM ─────────────────────────────────────────────
   O quadro rola por dentro quando o conteudo nao cabe, e ate aqui isso
   acontecia SEM AVISO NENHUM: a ultima linha era cortada e nada na tela
   dizia que havia mais. O professor perdia itens sem saber.
   Truque de fundo puro: as duas primeiras camadas sao `local` (rolam
   com o conteudo) e tapam as duas seguintes, que sao `scroll` (ficam
   presas na caixa). Resultado: a sombra so aparece do lado em que ainda
   ha conteudo, e some sozinha quando chega ao fim. Sem JS. */
.bd > .in{
  background:
    linear-gradient(var(--mat) 34%, rgba(0,0,0,0)) top    / 100% 22px no-repeat,
    linear-gradient(rgba(0,0,0,0), var(--mat) 66%) bottom / 100% 22px no-repeat,
    radial-gradient(farthest-side at 50% 0,   rgba(0,0,0,.30), rgba(0,0,0,0)) top    / 100% 9px no-repeat,
    radial-gradient(farthest-side at 50% 100%,rgba(0,0,0,.30), rgba(0,0,0,0)) bottom / 100% 9px no-repeat;
  background-attachment: local, local, scroll, scroll;
}
[data-luz="dia"] .bd > .in{
  background:
    linear-gradient(var(--mat) 34%, rgba(255,255,255,0)) top    / 100% 22px no-repeat,
    linear-gradient(rgba(255,255,255,0), var(--mat) 66%) bottom / 100% 22px no-repeat,
    radial-gradient(farthest-side at 50% 0,   rgba(10,16,24,.16), rgba(0,0,0,0)) top    / 100% 9px no-repeat,
    radial-gradient(farthest-side at 50% 100%,rgba(10,16,24,.16), rgba(0,0,0,0)) bottom / 100% 9px no-repeat;
  background-attachment: local, local, scroll, scroll;
}

/* ══════════════════════════════════════════════════════════════════
   O EDITOR LOCAL · pertence ao sistema visual da aula, não é um CMS.
   Fora do modo de edição ele não existe: nem borda, nem ícone, nem
   um pixel a mais na tela do aluno.
   ══════════════════════════════════════════════════════════════════ */

/* uma marca discreta onde há sobreposição local — só na edição */
body.editando [data-ed]{outline:1px dashed var(--v-pr-fio);outline-offset:3px;
  border-radius:3px;cursor:text;transition:var(--m-cromo)}
body.editando [data-ed]:hover{outline-color:var(--v-pr);background:var(--v-pr-vidro)}
body.editando [data-ed]::after{content:' ✎';font-size:.62em;color:var(--v-pr);opacity:.55}
[data-ed].temlocal{border-bottom:1.5px solid var(--v-pr-fio)}
body.editando [data-ed].temlocal{outline-style:solid;outline-color:var(--v-pr)}
body.editando .stage{padding-bottom:0}

/* o balão de edição de um campo */
.edcx{display:block;margin:var(--s2) 0;padding:var(--s3);border-radius:var(--r-well);
  border:1px solid var(--v-pr);background:var(--bg2);box-shadow:var(--sh3);
  animation:ent 160ms both;max-width:44rem;position:relative;z-index:20}
.edcx .edh{display:flex;align-items:center;gap:var(--s2);margin-bottom:var(--s2)}
.edcx .edh k{font-family:var(--mo);font-size:.54rem;letter-spacing:.18em;color:var(--v-pr)}
.edcx .edh .sp{flex:1}
.edta{width:100%;font-family:var(--se);font-size:1.04rem;line-height:1.4;color:var(--t1);
  background:var(--s-1);border:1px solid var(--ln2);border-radius:var(--r-piece);
  padding:var(--s3);resize:vertical;min-height:4.4rem}
.edta:focus{outline:none;border-color:var(--v-pr);background:var(--v-pr-vidro)}
.edorig{margin-top:var(--s2);border-left:2px solid var(--ln2);padding-left:var(--s3)}
.edorig k{font-family:var(--mo);font-size:.5rem;letter-spacing:.18em;color:var(--t3)}
.edorig p{margin:2px 0 0;font-family:var(--se);font-size:.94rem;line-height:1.35;color:var(--t3)}
.edf{display:flex;align-items:center;gap:var(--s2);margin-top:var(--s3);flex-wrap:wrap}
.edf .go{min-height:36px;padding:0 var(--s4);font-size:.6rem}

/* o painel lateral */
.painel{position:fixed;top:0;right:0;bottom:0;width:min(400px,92vw);z-index:78;
  background:var(--bg2);border-left:1px solid var(--v-pr-fio);box-shadow:var(--sh3);
  display:none;flex-direction:column}
.painel.on{display:flex}
.pnh{display:flex;align-items:center;gap:var(--s2);padding:var(--s4) var(--s5);
  border-bottom:1px solid var(--ln)}
.pnh h3{margin:0;font-family:var(--mo);font-size:.62rem;letter-spacing:.2em;color:var(--v-pr)}
.pnh .sp{flex:1}
.pnin{padding:var(--s5);overflow-y:auto;display:flex;flex-direction:column;gap:var(--s5)}
.pnav{margin:0;font-size:.84rem;line-height:1.55;color:var(--t2);
  border-left:2px solid var(--v-pr-fio);padding-left:var(--s3)}
.pnbl{display:flex;flex-direction:column;gap:7px}
.pnbl > k{font-family:var(--mo);font-size:.54rem;letter-spacing:.2em;color:var(--v-pr)}
.pnbl > s{text-decoration:none;font-size:.72rem;line-height:1.45;color:var(--t3)}
.pnnota,.pnq{width:100%;font-family:var(--ui);font-size:.9rem;color:var(--t1);
  background:var(--s-1);border:1px solid var(--ln2);border-radius:var(--r-piece);
  padding:9px var(--s3);min-height:40px;resize:vertical}
.pnnota:focus,.pnq:focus{outline:none;border-color:var(--v-pr);background:var(--v-pr-vidro)}
.pnqs{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:5px;counter-reset:q}
.pnqs li{counter-increment:q;display:flex;align-items:baseline;gap:var(--s2);
  font-family:var(--se);font-size:.96rem;color:var(--t1);
  border-left:2px solid var(--v-yo-fio);padding-left:var(--s3)}
.pnqs li span{flex:1}
.pnqs .cb{width:30px;min-width:30px;height:30px}
.pned{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:4px}
.pned li{display:flex;align-items:center;gap:var(--s2);font-family:var(--mo);
  font-size:.62rem;color:var(--t2)}
.pned li b{flex:1;font-weight:400;color:var(--t1)}
.pned .cb{width:auto;padding:0 var(--s2);font-size:.56rem;border:1px solid var(--ln2)}
.pnv{margin:0;font-size:.82rem;color:var(--t3)}
#pnzera{text-align:left;line-height:1.35;padding:var(--s2) var(--s3);height:auto;min-height:36px}

/* a pergunta que o professor acrescentou */
.hub .q.minha p{color:var(--v-yo)}
.mk-minha{display:inline-block;margin-left:var(--s2);font-family:var(--mo);font-size:.5rem;
  letter-spacing:.16em;color:var(--v-yo);border:1px solid var(--v-yo-fio);
  border-radius:var(--r-pill);padding:1px 6px;vertical-align:middle}

/* a nota privada, dentro da gaveta do professor */
.minhanota{border-left:2px solid var(--v-yo);padding-left:var(--s3)}
.minhanota k{color:var(--v-yo)!important}

/* o aviso de gravação */
.toast{position:fixed;left:50%;bottom:var(--s6);transform:translate(-50%,14px);z-index:90;
  padding:10px var(--s5);border-radius:var(--r-pill);font-family:var(--mo);font-size:.62rem;
  letter-spacing:.12em;opacity:0;pointer-events:none;transition:var(--m-peca);
  border:1px solid var(--v-er);background:var(--bg2);color:var(--v-er);box-shadow:var(--sh3)}
.toast.on{opacity:1;transform:translate(-50%,0)}
.toast.ok{border-color:var(--v-ok);color:var(--v-ok)}

@media (max-width:860px){ .painel{width:100%} }

/* ══════════════════════════════════════════════════════════════════
   A PRANCHA DAS HORAS · face PROJETO
   Papel milimetrado, cotas, fio em vez de sombra. O mostrador é a peça
   e ele é desenhado como relógio de verdade: 60 traços, algarismos, o
   ponteiro das horas andando com o minuto. Nada pede para digitar.
   ══════════════════════════════════════════════════════════════════ */

.obj2{list-style:none;margin:0;padding:0;counter-reset:o;display:flex;flex-direction:column;gap:2px}
.obj2 li{counter-increment:o;display:grid;grid-template-columns:26px 1fr;gap:var(--s3);
  padding:var(--s2) 0;border-bottom:1px solid var(--ln);font-size:1.02rem;line-height:1.45}
.obj2 li:last-child{border-bottom:0}
.obj2 li::before{content:counter(o,decimal-leading-zero);font-family:var(--mo);font-size:.62rem;
  color:var(--t3);letter-spacing:.06em;padding-top:.35em}
.modo{align-self:flex-start;font-family:var(--mo);font-size:.5rem;letter-spacing:.26em;
  color:var(--v-ac);border:1px solid var(--v-ac-fio);border-radius:2px;padding:2px 9px}
.recusa{margin:0;font-family:var(--se);font-size:1rem;color:var(--v-er)}
.nota{margin:0;font-size:.9rem;line-height:1.45;color:var(--t3)}
.fecho{margin:0;font-family:var(--se);font-size:1.14rem;line-height:1.45;color:var(--v-ac);
  text-align:center;animation:ent 300ms both}
.ph.doc{border:1px solid var(--mat-fio);overflow:hidden;position:relative}
.ph.doc img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.85) contrast(1.05)}
.ph.doc cap{position:absolute;left:0;bottom:0;padding:6px 10px;background:var(--scrim);
  font-family:var(--mo);font-size:.5rem;letter-spacing:.2em;color:var(--on-photo)}

/* ── O MOSTRADOR ─────────────────────────────────────────────── */
.rel{width:100%;height:auto;display:block}
.rel circle,.rel line,.rel path{fill:none;vector-effect:non-scaling-stroke;stroke-linecap:round}
.rel .ref{stroke:var(--v-ac);stroke-width:1;opacity:.28;stroke-dasharray:3 5}
.rel .dial{stroke:var(--grafite);stroke-width:1.6;fill:rgba(255,255,255,.015)}
[data-luz="dia"] .rel .dial{fill:rgba(255,255,255,.7)}
.rel .tk{stroke:var(--grafite);stroke-width:1;opacity:.55}
.rel .tk.h{stroke:var(--grafite);stroke-width:2;opacity:1}
.rel .nm{fill:var(--t1);font-family:var(--mo);font-size:15px}
.rel .hh{stroke:var(--t1);stroke-width:6}
.rel .mm{stroke:var(--v-ac);stroke-width:3}
.rel .pino{fill:var(--v-ac);stroke:none}
.rel .pino2{fill:var(--bg);stroke:none}
/* o arco de cota: a MEDIDA da meia hora, contada do doze até o ponteiro */
.rel .arc{stroke:var(--v-pr);stroke-width:1.4;stroke-dasharray:4 3}
.rel .meio{stroke:var(--v-ac);stroke-width:1;stroke-dasharray:5 5;opacity:.5}

/* seis mostradores em fila davam 90px cada: numeros ilegiveis numa aula
   cujo exercicio E LER O MOSTRADOR. Tres por linha, duas linhas, com a
   peca limitada em px para as duas linhas caberem na altura da cena. */
.mostr{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--s3);width:100%}
@media (max-width:900px){.mostr{grid-template-columns:repeat(2,1fr)}}
@media (max-width:560px){.mostr{grid-template-columns:1fr}}
.mv .rel{max-width:min(100%,152px);margin:0 auto}
.mostr:not(.tres) .mv .rel{max-width:min(100%,190px)}
.mv{margin:0;display:flex;flex-direction:column;gap:6px;padding:var(--s3);
  border:1px solid var(--mat-fio);background:var(--mat);border-radius:var(--r-plate)}
.mv.feita{border-color:var(--v-ok)}
.mv figcaption{display:flex;flex-direction:column;gap:5px;align-items:center}
.chk{font-family:var(--mo);font-size:.54rem;letter-spacing:.18em;color:var(--t3);
  background:none;border:1px dashed var(--ln2);border-radius:2px;padding:6px 12px;
  min-height:32px;cursor:pointer}
.chk:hover{border-color:var(--v-ac);color:var(--v-ac)}
.lida{font-family:var(--se);font-size:.98rem;line-height:1.25;color:var(--t1);text-align:center;
  animation:ent 200ms both}
.ops3{display:flex;flex-direction:column;gap:4px;width:100%}
.peca.opt{font-family:var(--se);font-size:.88rem;color:var(--t2);background:var(--s-1);
  border:1px solid var(--ln);border-radius:2px;padding:5px 8px;min-height:31px;cursor:pointer;
  transition:var(--m-peca)}
.peca.opt:hover{border-color:var(--v-ac);color:var(--t1)}
.peca.opt.ok{border-color:var(--v-ok);color:var(--v-ok)}
.peca.opt.err{border-color:var(--v-er);color:var(--v-er);animation:shk 300ms}
.pq{margin:0;font-family:var(--se);font-size:.94rem;color:var(--v-ok);text-align:center;
  animation:ent 200ms both}
.pqw{display:flex;flex-direction:column;gap:4px;align-items:center;animation:ent 200ms both}
.pqw .en{font-family:var(--se);font-size:.94rem;color:var(--v-ok);text-align:center}
.legenda{display:flex;gap:var(--s5);justify-content:center;flex-wrap:wrap}
.lg2{display:flex;align-items:baseline;gap:8px}
.lg2 b{font-family:var(--mo);font-size:.7rem;letter-spacing:.16em;color:var(--v-ac)}
.lg2 i{font-style:normal;font-size:.84rem;color:var(--t3)}
/* a janela da cena V: o que decide AM ou PM não é o mostrador */
.jn{display:flex;align-items:center;gap:7px;padding:5px 8px;border-radius:2px;
  border:1px solid var(--ln);background:var(--s-1)}
.sol{width:11px;height:11px;border-radius:50%;flex:0 0 auto}
.janela.dia .sol{background:var(--v-pr);box-shadow:0 0 0 3px rgba(233,184,114,.16)}
.janela.noite .sol{background:transparent;border:1.5px solid var(--t3)}
.jl{font-family:var(--mo);font-size:.48rem;letter-spacing:.16em;color:var(--t3)}

/* ── I · a hora dele ─────────────────────────────────────────── */
.esc{display:grid;grid-template-columns:1fr 1fr;gap:var(--s2)}
@media (max-width:620px){.esc{grid-template-columns:1fr}}
.op1{display:flex;flex-direction:column;gap:5px;text-align:left;cursor:pointer;
  padding:var(--s3);min-height:var(--target);border-radius:2px;
  border:1px solid var(--ln);border-bottom:2px solid var(--v-yo-fio);
  background:var(--s-1);transition:var(--m-peca)}
.op1:hover{border-color:var(--v-yo)}
.op1 .en{font-family:var(--se);font-size:1.04rem;line-height:1.3;color:var(--t1)}
.op1 i{font-style:normal;font-size:.8rem;line-height:1.3;color:var(--t3)}
.op1.pego{border-color:var(--v-yo);background:var(--v-yo-vidro)}
.op1.pego .en{color:var(--v-yo)}

/* ── VI · a linha do dia ─────────────────────────────────────── */
.linhat{display:grid;grid-template-columns:repeat(8,1fr);gap:var(--s2);width:100%}
@media (max-width:1000px){.linhat{grid-template-columns:repeat(4,1fr)}}
.ht{display:flex;flex-direction:column;gap:4px;padding:var(--s2);min-height:5rem;
  border:1px solid var(--ln);border-top:2px solid var(--ln2);background:var(--s-1);
  border-radius:0 0 2px 2px;cursor:pointer;transition:var(--m-peca)}
.ht:hover{border-top-color:var(--v-ac)}
.ht.nao{border-color:var(--v-er);animation:shk 300ms}
.ht k{font-family:var(--mo);font-size:.56rem;letter-spacing:.1em;color:var(--v-ac)}
.htin{display:flex;flex-direction:column;gap:3px}
.posta{margin:0;font-family:var(--se);font-size:.84rem;line-height:1.2;color:var(--t1);
  animation:ent 200ms both}
.falas{display:grid;grid-template-columns:1fr 1fr 1fr;gap:5px}
@media (max-width:1000px){.falas{grid-template-columns:1fr 1fr}}
@media (max-width:640px){.falas{grid-template-columns:1fr}}
.fa2{text-align:left;cursor:pointer;padding:8px var(--s3);min-height:38px;border-radius:2px;
  border:1px solid var(--ln);background:var(--s-1);transition:var(--m-peca)}
.fa2 .en{font-family:var(--se);font-size:.96rem;color:var(--t1)}
.fa2:hover{border-color:var(--v-ac)}
.fa2.pega{border-color:var(--v-ac);background:var(--v-ac-vidro)}
.fa2.foi{opacity:.26;pointer-events:none;text-decoration:line-through}

/* ── VII · a agenda ──────────────────────────────────────────── */
.agenda{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--s2);width:100%}
@media (max-width:1000px){.agenda{grid-template-columns:1fr 1fr}}
@media (max-width:640px){.agenda{grid-template-columns:1fr}}
.ag{display:flex;flex-direction:column;gap:4px;text-align:left;cursor:pointer;padding:var(--s3);
  min-height:4.4rem;border-radius:2px;border:1px solid var(--mat-fio);background:var(--mat);
  transition:var(--m-peca)}
.ag:hover{border-color:var(--v-ac)}
.ag k{font-family:var(--mo);font-size:.66rem;letter-spacing:.1em;color:var(--v-ac)}
.ag .en{font-family:var(--se);font-size:.98rem;line-height:1.25;color:var(--t1)}
.ag.err{border-color:var(--v-er);animation:shk 300ms}
.ag.quase{border-color:var(--v-pr)}
.ag.bate{border-color:var(--v-er);background:rgba(228,104,92,.10)}
.ag.bate k{color:var(--v-er)}

/* ── VIII · a conta ──────────────────────────────────────────── */
.seis{display:grid;grid-template-columns:1fr 1fr;gap:0 var(--s6);align-content:start}
@media (max-width:900px){.seis{grid-template-columns:1fr}}
.seis > *:nth-last-child(-n+2){border-bottom:0}
.bl{display:flex;flex-direction:column;gap:4px;align-items:flex-start;padding:6px 0;
  border-bottom:1px solid var(--ln)}
.blh{display:flex;align-items:baseline;gap:8px}
.blh k{font-family:var(--mo);font-size:.66rem;letter-spacing:.06em;color:var(--v-ac)}
.ate{color:var(--t3)}
.blo{margin:0;font-family:var(--se);font-size:.96rem;line-height:1.2;color:var(--t1)}
.peca.tomar{font-family:var(--mo);font-size:.5rem;letter-spacing:.14em;color:var(--t3);
  background:none;border:1px dashed var(--ln2);border-radius:2px;padding:5px 10px;
  min-height:30px;cursor:pointer}
.peca.tomar:hover{border-color:var(--v-ac);color:var(--v-ac)}
.hs{font-family:var(--mo);font-size:.9rem;color:var(--v-ok);animation:ent 200ms both}
.bl.dorme{border-top:1px solid var(--ln2)}
.tag.ttl{font-family:var(--mo);transition:color 200ms,border-color 200ms}
.tag.ttl.estoura{color:var(--v-er);border-color:var(--v-er)}

/* ── IX · a verdade ──────────────────────────────────────────── */
.fatos{list-style:none;margin:0;padding:0;counter-reset:f;display:flex;flex-direction:column;gap:5px}
.fatos li{counter-increment:f;display:grid;grid-template-columns:22px 1fr;gap:var(--s2);
  font-family:var(--se);font-size:1.04rem;line-height:1.35;color:var(--t1)}
.fatos li::before{content:counter(f,decimal-leading-zero);font-family:var(--mo);
  font-size:.56rem;color:var(--v-ac);padding-top:.4em}
.perg2{margin:0;font-family:var(--di);font-weight:500;font-size:clamp(1.15rem,2.2vw,1.6rem);
  line-height:1.25;color:var(--t1)}
.dela{display:flex;flex-direction:column;gap:5px;padding:var(--s4);border-radius:var(--r-plate);
  border:1px solid var(--v-ac-fio);background:var(--v-ac-vidro);animation:ent 260ms both}
.dela k{font-family:var(--mo);font-size:.52rem;letter-spacing:.2em;color:var(--t3)}
.dela p{margin:0;font-family:var(--se);font-size:1.24rem;line-height:1.3;color:var(--v-ac)}
.dela i{font-style:normal;font-size:.92rem;color:var(--t2)}

/* ── X · as perguntas ────────────────────────────────────────── */
.pgs{display:grid;grid-template-columns:1fr 1fr;gap:var(--s2);width:100%}
@media (max-width:900px){.pgs{grid-template-columns:1fr}}
.pg{border:1px solid var(--ln);border-radius:2px;background:var(--s-1);overflow:hidden}
.pg.vista{border-color:var(--v-yo-fio)}
.pg.volta{border-color:var(--v-yo);grid-column:1/-1}
.pgh{display:flex;align-items:baseline;gap:var(--s3);width:100%;text-align:left;cursor:pointer;
  padding:var(--s3);min-height:var(--target);background:none;border:0}
.pgh i{font-family:var(--mo);font-style:normal;font-size:.58rem;color:var(--v-yo);flex:0 0 auto}
.pgh .en{font-family:var(--se);font-size:1.02rem;line-height:1.35;color:var(--t1)}
.pgh .ar{color:var(--t3);transition:var(--m-peca)}
.pg.ab .pgh .ar{transform:rotate(180deg)}
.pgin{display:none;flex-direction:column;gap:4px;padding:0 var(--s3) var(--s3)}
.pg.ab .pgin{display:flex}
.ini{margin:0;font-family:var(--se);font-size:.96rem;line-height:1.3;color:var(--t2);
  padding-left:var(--s3);border-left:1px solid var(--ln)}
.ini.dele{color:var(--v-yo);border-left-color:var(--v-yo);font-size:1.08rem}

/* ── fecho ───────────────────────────────────────────────────── */
.selo{width:60px;height:60px;background:var(--mark) center/contain no-repeat;
  filter:drop-shadow(0 2px 8px rgba(0,0,0,.45));opacity:.96}
[data-luz="dia"] .selo{filter:none}
.fim{margin:0;font-family:var(--di);font-weight:500;letter-spacing:.04em;
  font-size:clamp(1.6rem,3.6vw,2.8rem);line-height:1;color:var(--t1)}
.tres3{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--s4);max-width:62rem;width:100%}
@media (max-width:800px){.tres3{grid-template-columns:1fr}}
.tr{display:flex;flex-direction:column;gap:3px;padding:var(--s4);border-radius:var(--r-plate);
  border:1px solid var(--mat-fio);background:var(--mat);text-align:left}
.tr k{font-family:var(--mo);font-size:.54rem;letter-spacing:.18em;color:var(--t3)}
.tr b{font-family:var(--di);font-weight:600;font-size:2rem;line-height:1;color:var(--v-ac)}
.tr i{font-style:normal;font-size:.88rem;color:var(--t2)}

/* ── extra ───────────────────────────────────────────────────── */
.arena{align-items:center;text-align:center;gap:var(--s4);max-width:52rem;justify-self:center}
.vaz{margin:0;font-family:var(--di);font-weight:400;font-size:clamp(1.5rem,3vw,2.2rem);
  line-height:1.1;color:var(--t3)}
.prompt{margin:0;font-family:var(--se);font-size:clamp(1.15rem,2.3vw,1.6rem);line-height:1.35;
  color:var(--t1);max-width:38ch}
.soc{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--s2);width:100%}
@media (max-width:700px){.soc{grid-template-columns:1fr}}
.cart{display:flex;flex-direction:column;gap:5px;text-align:left;cursor:pointer;padding:var(--s3);
  min-height:3.4rem;border-radius:2px;border:1px dashed var(--ln2);background:transparent;
  transition:var(--m-peca)}
.cart:hover{border-color:var(--v-ac)}
.cart k{font-family:var(--mo);font-size:.5rem;letter-spacing:.2em;color:var(--t3)}
.cart .en{font-family:var(--se);font-size:.98rem;color:var(--t1)}
.cart.ab{border-style:solid;border-color:var(--v-ac);background:var(--s-1)}

.L.imgcon{align-items:stretch}
.L.imgcon > .ph{align-self:center}
.L.imgcon > .col{overflow-y:auto;min-height:0}
.L.wide > .col.mid{gap:var(--s3)}
</style>
</head>
<body>
<div class="app f-projeto" id="app">

  <header class="top">
    <button class="cb" id="brail" aria-label="mostrar ou esconder as cenas" aria-pressed="false" title="mostrar ou esconder a coluna das cenas (S)">
      <svg viewBox="0 0 24 24"><path d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z"/></svg></button>
    <span class="marca"><i class="mk"></i>
      <span class="nm"><b>WOLF LABS</b><s>MAIN SERIES</s></span></span>
    <span class="tag">A1</span>
    <span class="ti">Twenty-Five Hours</span>
    <span class="sp"></span>
    <span class="tag" id="cena">—</span>
    <span class="zm" title="tamanho do texto — fica guardado neste computador">
      <button class="cb" id="zmMenos" aria-label="texto menor">&minus;</button>
      <b id="zmLbl">100%</b>
      <button class="cb" id="zmMais" aria-label="texto maior">+</button>
    </span>
    <button class="cb w" id="bedit" title="editar esta aula — as mudanças ficam neste computador">EDIT</button>
    <button class="cb w" id="btrans" title="a transcrição do áudio desta cena — abre só quando você quiser" hidden>SCRIPT</button>
    <button class="cb w" id="blousa" title="a lousa — as suas anotações (B)">BOARD</button>
    <button class="cb w" id="bluz" aria-pressed="false" title="noite, ou papel para preparar e imprimir (L)"><span>NOITE</span></button>
    <button class="cb w" id="bprof" aria-pressed="false" title="coluna do professor (G)">TEACHER</button>
    <button class="cb" id="bfull" title="tela cheia (F)" aria-label="tela cheia">
      <svg viewBox="0 0 24 24"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"
        fill="none" stroke="currentColor" stroke-width="2"/></svg></button>
  </header>

  <div class="body">
    <nav class="rail" id="rail"></nav>
    <div class="stage" id="stage"></div>
    <aside class="prof" id="prof">
      <h4><span>TEACHER · O ALUNO VÊ ISTO SE VOCÊ ESTIVER PARTILHANDO A TELA</span>
        <span class="sp"></span>
        <button class="cb" id="bprof2" onclick="document.getElementById('prof').classList.remove('on')">✕</button></h4>
      <div class="in" id="profin"></div>
      <div class="carimbo">BUILD 07/09 19:00</div>
    </aside>
  </div>

  <footer class="foot">
    <button class="go gh" id="ant">◂ BACK</button>
    <div class="bar"><i id="barra"></i></div>
    <span class="ct" id="conta">0 / 0</span>
    <button class="go" id="prox">NEXT ▸</button>
  </footer>
</div>

<div class="veu" id="veu"><div class="pop"></div></div>

<!-- O EDITOR LOCAL DO PROFESSOR · nada daqui sai deste navegador -->
<aside class="painel" id="painel" aria-label="editor local" data-wl-lock>
  <div class="pnh"><h3>MY COPY</h3><span class="sp"></span>
    <button class="cb" onclick="modoEdicao(false)" aria-label="sair da edição">&times;</button></div>
  <div class="pnin" id="painelin"></div>
</aside>
<div class="toast" id="toast"></div>

<!-- A LOUSA DO PROFESSOR · fica neste computador, o aluno nunca vê -->
<div class="lscrim" id="lscrim"></div>
<aside class="lousa" id="lousa" aria-label="a lousa do professor" data-wl-lock>
  <div class="lh"><h3>The Board</h3><span class="sp"></span>
    <span class="salvo" id="lsalvo">saved</span>
    <button class="cb" id="lfecha" aria-label="fechar">&times;</button></div>
  <div class="ltags">
    <button class="ltg" data-t="WORD">word</button>
    <button class="ltg" data-t="FIX">fix</button>
    <button class="ltg" data-t="GOOD">good</button>
    <button class="ltg" data-t="ASK">ask</button>
    <button class="ltg" data-t="SCENE">scene</button>
  </div>
  <textarea class="ltxt" id="ltxt"
    placeholder="Notes for this student. Everything stays on this computer."></textarea>
  <div class="lf">
    <button class="go gh" id="lcopy">Copy</button>
    <button class="go gh" id="ldl">Download</button>
    <button class="go gh" id="lclear">Clear</button>
  </div>
</aside>

<script>
window.AULA_ID='time-wolf-v2';
window.AULA_TITULO='Twenty-Five Hours';
window.AULA_NIVEL='A1';
window.AULA_NOME='TWENTY-FIVE HOURS';
window.AULA_FACE='f-projeto';

window.GLOSS={
 'past':{w:'past',tp:'A METADE ANDA PARA TRÁS',say:'/pɑːst/',
   pt:'passada — a hora que já passou',
   d:'Aqui está o erro que mais sobrevive. Em português a meia hora pertence à hora que <b>vem</b>: <i>oito e meia</i>. Em inglês ela é contada <b>a partir</b> da hora que <b>já passou</b>: <b>half past eight</b>. A palavra não é o problema — a <b>direção</b> é.',
   ex:'It&rsquo;s half past eight.',
   no:'It&rsquo;s eight and half.',si:'It&rsquo;s half past eight.'},
 'to':{w:'to',tp:'CONTA PARA TRÁS',say:'/tuː/ · /tə/',
   pt:'para — faltam tantos para',
   d:'Depois dos trinta minutos o inglês vira e conta o que <b>falta</b>: <b>quarter to nine</b> são oito e quarenta e cinco. Repare que o <b>oito não aparece na frase</b> — só a hora que ainda vai chegar.',
   ex:'It&rsquo;s quarter to nine. (8:45)'},
 'quarter':{w:'quarter',tp:'QUINZE MINUTOS',say:'/ˈkwɔː.tər/',
   pt:'um quarto — quinze minutos',
   d:'Um quarto do mostrador. Vai dos dois lados: <b>quarter past</b> quando já passou, <b>quarter to</b> quando falta. E vem sem artigo em inglês falado: <i>quarter past nine</i>, não <i>a quarter past nine</i> — as duas existem, e a curta é a de todo dia.',
   ex:'quarter past nine &middot; quarter to nine'},
 'oclock':{w:'o&rsquo;clock',tp:'SÓ NA HORA CHEIA',say:'/əˈklɒk/',
   pt:'em ponto',
   d:'Só entra quando o ponteiro dos minutos está <b>no doze</b>. Nunca com meia, nunca com quinze. E é a resposta para o outro erro comum: <i>horas</i> não tem gêmeo em inglês — não existe <i>at eight hours</i>.',
   ex:'It&rsquo;s eight o&rsquo;clock.',
   no:'I start at eight hours.',si:'I start at eight o&rsquo;clock.'},
 'am':{w:'AM / PM',tp:'O QUE PARTE O DIA',say:'/eɪ ˈem/ · /piː ˈem/',
   pt:'da manhã / da tarde e da noite',
   d:'Um mostrador redondo só conhece <b>doze</b> horas, então há duas sete horas em cada dia. Quem separa é AM e PM. Inglês falado diz <b>five forty-two PM</b>, e quase nunca <i>seventeen forty-two</i>.',
   ex:'seven AM &middot; seven PM'},
 'midday':{w:'midday',tp:'MEIO-DIA',say:'/ˌmɪdˈdeɪ/',pt:'meio-dia',
   d:'Doze horas com o sol em cima. Também <b>noon</b>. No relógio de doze horas ele é <b>12 PM</b> — que confunde todo mundo, inclusive quem fala inglês desde criança.'},
 'midnight':{w:'midnight',tp:'MEIA-NOITE',say:'/ˈmɪd.naɪt/',pt:'meia-noite',
   d:'Doze horas do outro lado. É <b>12 AM</b>, e é onde o dia recomeça.'}};

var L=[

{type:'protocol',ch:'Teacher Guide',
 t:'Twenty-Five Hours',
 pre:'Somebody posted their perfect day online. Every hour of it. The hours add up to twenty-five, and the day still looks true.',
 objetivos:[
  'read a round clock out loud: <b>It&rsquo;s eight o&rsquo;clock</b>',
  'count the half backwards: <b>half past eight</b>, never <i>eight and half</i>',
  'pick a side: <b>quarter past nine</b> &middot; <b>quarter to nine</b>',
  'split the day: <b>seven AM</b> &middot; <b>seven PM</b>',
  'ask and answer: <b>What time do you wake up?</b>'],
 teacher:{sec:'—',
  do:'Read the three traps before you open the lesson. All three come from his own language.',
  watch:'<b>THE HALF WALKS BACKWARDS.</b> In his language the half belongs to the hour that is coming &mdash; <i>oito e meia</i>. In English it is counted FROM the hour that already passed: half past eight. The error is not the word, it is the direction. Second: <i>horas</i> has no English twin, so out comes <i>at eight hours</i>. Third: a round clock only knows twelve, and AM/PM is what splits the day.',
  stuck:'Cover the long hand and ask for the hour only.',
  strong:'Give him 8:45 and ask for both ways of saying it.'}},

/* ── I · CONVERSATION · a hora dele, sem digitar ─────────────── */
{type:'hrabrir',ch:'I · Her Perfect Day',min:3,layout:'imgcon',modo:'CONVERSATION',
 kick:'A1 · TELLING THE TIME',
 foto:'img/mesa.jpg',cap:'SOMEBODY POSTED THEIR PERFECT DAY',
 t:'What time did you wake up today?',
 pre:'Before hers, yours. Somebody posted their perfect day online &mdash; every hour of it.',
 como:'Say it out loud <b>first</b>, however it comes out. Then pick the closest one.',
 escolhas:[
  {t:'At seven.',d:'The hour on its own. Correct, and the shortest.'},
  {t:'At half past six.',d:'Half an hour after six &mdash; and the half walks backwards.'},
  {t:'At quarter past eight.',d:'Fifteen minutes after eight.'},
  {t:'Too late.',d:'Also an answer. We will get the number later.'}],
 dica:'Nothing here gets corrected. This is the before picture.',
 done:'That is your time. Now hers &mdash; and hers has a problem.',
 teacher:{sec:'3 min · conversation',
  do:'One time, fast, and take it however it comes out. Say yours first. He picks the card AFTER he has said it.',
  watch:'Listen for two things and do not correct either: EIGHT AND HALF, and AT EIGHT HOURS. Those are scenes III and X, and they have to exist out loud before they can be fixed.',
  stuck:'Hold up fingers and say a number.',
  strong:'Ask what time he woke up on Sunday, and how that felt.'}},

/* ── II · BOARD + AUDIO · o mostrador ────────────────────────── */
{type:'hrface',ch:'II · The Face',min:6,layout:'wide',modo:'BOARD',script:1,
 t:'Read the face',
 pre:'Short hand is the hour. Long one is the minutes. Nobody has to count the little lines.',
 como:'Read the time out loud. <b>Then</b> check, and hear it.',
 relogios:[
  {h:8,m:0,en:'It&rsquo;s eight ~oclock~.',au:'t-8.mp3'},
  {h:9,m:0,en:'It&rsquo;s nine o&rsquo;clock.',au:'t-9.mp3'},
  {h:2,m:0,en:'It&rsquo;s two o&rsquo;clock.',au:'t-2.mp3'},
  {h:8,m:30,en:'It&rsquo;s half ~past~ eight.',au:'t-830.mp3'},
  {h:3,m:30,en:'It&rsquo;s half past three.',au:'t-330.mp3'},
  {h:9,m:15,en:'It&rsquo;s ~quarter~ past nine.',au:'t-915.mp3'}],
 done:'Six faces read out loud. Nobody had to count the little lines.',
 teacher:{sec:'6 min',
  do:'Say it BEFORE you check, every single time. If he taps CHECK first, put the clock back and start the round again &mdash; the guess out loud is the whole exercise.',
  watch:'Plenty of adults cannot read a round clock at all, and there is no shame in it: they grew up with numbers on a screen. If yours hesitates, point at the short hand and say HOUR, then the long one and say MINUTES.',
  stuck:'Cover the long hand and ask for the hour only.',
  strong:'Ask him to say the time the other way too, when there is one.'}},

/* ── III · CONTRAST · a meia hora anda para trás ─────────────── */
{type:'hrmeia',ch:'III · Half Past, Not And a Half',min:7,layout:'wide',modo:'CONTRAST',
 t:'The direction changes',
 pre:'His language ADDS. English counts FROM. Same half hour, opposite direction.',
 como:'Which hour <b>already happened</b>? Pick the piece, then read the whole thing.',
 relogios:[{h:8,m:30},{h:10,m:30},{h:6,m:30},{h:1,m:30},{h:11,m:30},{h:4,m:30}],
 porque:{
  vem:'That hour has not happened yet. The half is counted from the one that did.',
  to:'TO counts backwards from a whole hour, and half an hour is not backwards from anything.'},
 recusa:'Look at the short hand. Which number did it already leave behind?',
 done:'Six times, and the half never belonged to the hour that comes next.',
 teacher:{sec:'7 min · the trap',
  do:'Let him choose the wrong one early, and read the reason on the screen together. The word is not the problem &mdash; the direction is. Say it once with your hands: his language ADDS, English counts FROM.',
  watch:'HALF TO NINE is the other error, and it is the sign that the reason landed halfway. He understood that English counts from something; he picked the wrong something.',
  stuck:'Ask which hour already happened.',
  strong:'Say a time in his language and let him give you the English.'}},

/* ── IV · CONTRAST · past e to, e a face parte ao meio ───────── */
{type:'hrlado',ch:'IV · Past and To',min:7,layout:'wide',modo:'CONTRAST',
 t:'Which way is it going?',
 pre:'Cut the face in half. The right side counts forward, the left side counts back. The face tells you before the words do.',
 como:'Look at the side the long hand is in. Pick it. <b>Then</b> say the time.',
 lados:[{k:'past',nm:'PAST',oq:'right side &middot; it already happened'},
        {k:'to',nm:'TO',oq:'left side &middot; it has not arrived'}],
 relogios:[
  {h:9,m:15,lado:'past',en:'It&rsquo;s ~quarter~ past nine.'},
  {h:8,m:45,lado:'to',en:'It&rsquo;s quarter ~to~ nine.'},
  {h:3,m:15,lado:'past',en:'It&rsquo;s quarter past three.'},
  {h:6,m:45,lado:'to',en:'It&rsquo;s quarter to seven.'},
  {h:11,m:15,lado:'past',en:'It&rsquo;s quarter past eleven.'},
  {h:1,m:45,lado:'to',en:'It&rsquo;s quarter to two.'}],
 recusa:'Look at the long hand again. Which half of the face is it in?',
 done:'Right side forward, left side back. And TO names the hour that has not arrived yet.',
 teacher:{sec:'7 min',
  do:'Point at the FACE, not at the sentence. The right half is PAST, the left half is TO, and once he sees that, the words stop being a list to memorise.',
  watch:'The hard part is not PAST or TO &mdash; it is that TO names the hour that has NOT arrived. <b>Quarter to nine is eight forty-five, and the eight is nowhere in the sentence.</b> Say that out loud once.',
  stuck:'Ask which hour is coming next.',
  strong:'Give him 8:45 and ask for both ways of saying it.'}},

/* ── V · VISUAL + AUDIO · o mesmo rosto, duas horas ──────────── */
{type:'hrampm',ch:'V · The Same Face, Two Times',min:6,layout:'wide',modo:'VISUAL',script:1,
 t:'AM or PM',
 pre:'A round clock only knows twelve. Same hands, two windows &mdash; and only the window tells you which.',
 como:'Look at the window. Say the <b>whole</b> time, with AM or PM on the end.',
 rodadas:[
  {h:7,m:0,luz:1,en:'It&rsquo;s seven ~am~.',au:'t-7am.mp3'},
  {h:7,m:0,luz:0,en:'It&rsquo;s seven PM.',au:'t-7pm.mp3'},
  {h:11,m:30,luz:1,en:'It&rsquo;s half past eleven AM.',au:'t-1130am.mp3'},
  {h:11,m:30,luz:0,en:'It&rsquo;s half past eleven PM.',au:'t-1130pm.mp3'},
  {h:4,m:15,luz:1,en:'It&rsquo;s quarter past four AM.',au:'t-415am.mp3'},
  {h:4,m:15,luz:0,en:'It&rsquo;s quarter past four PM.',au:'t-415pm.mp3'}],
 op:[{k:'am',nm:'AM'},{k:'pm',nm:'PM'}],
 recusa:'Look at the window again. Is the sun up?',
 done:'Two sevens in one day, and only the window told you which.',
 teacher:{sec:'6 min',
  do:'This is where the clock in every other lesson comes from. English says five forty-two PM, not seventeen forty-two &mdash; so he has to hear the number small and the AM or PM after it.',
  watch:'Midday and midnight break everybody, and they are not in this scene on purpose. If he asks: twelve PM is midday, twelve AM is midnight. Then move on.',
  stuck:'Point at the window and ask if the sun is up.',
  strong:'Ask what he was doing at each of the six times today.'}},

