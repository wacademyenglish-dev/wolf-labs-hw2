                <div class="space-y-4 mt-auto">
                    <p class="text-[10px] text-slate-500 uppercase tracking-widest mb-2 font-tech text-center font-bold">Select the correct definition</p>
                    <div class="mcq-option" onclick="checkAnswer(this, 3, false, '')">
                        <span class="text-sm">Mixing different subjects in one session.</span>
                    </div>
                    <div class="mcq-option" onclick="checkAnswer(this, 3, true, 'myth')">
