                    <div class="mcq-option justify-center font-mono" onclick="checkAnswer(this, 2, false, '')">storing</div>
                </div>
            </div>

            <!-- SCREEN 3: VOCAB RECALL -->
            <div class="screen" id="screen-3">
                <div class="flex justify-between items-center mb-10 mt-4">
                    <div class="w-6"></div>
                    <span class="font-tech text-[10px] font-bold text-[var(--accent-cyan)] uppercase tracking-widest bg-[var(--accent-cyan)]/10 px-4 py-1.5 rounded-full border border-[var(--accent-cyan)]/20">Node 03/04</span>
