    <script>
        // -- Mobile Clock Logic --
        function updateClock() {
            const now = new Date();
            let h = now.getHours();
            let m = now.getMinutes();
            h = h < 10 ? '0'+h : h;
            m = m < 10 ? '0'+m : m;
            document.getElementById('clock').innerText = `${h}:${m}`;
        }
        setInterval(updateClock, 1000);
        updateClock();

        // -- Navigation Logic --
        let progress = 0;

        function goToScreen(num) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById(`screen-${num}`).classList.add('active');
            
            if(num === 0) {
                document.getElementById('main-progress').style.width = `${progress}%`;
                document.getElementById('main-progress-text').innerText = `${progress}%`;
                if(progress === 100) {
                    const btn = document.querySelector('#screen-0 .btn-protocol');
                    btn.innerText = "Re-Verify Data";
                    btn.style.backgroundColor = "transparent";
                    btn.style.borderColor = "white";
                    btn.style.color = "white";
                }
            }
        }

        // -- Minigame Logic --
        function checkAnswer(element, taskNum, isCorrect, textValue) {
            if (element.parentElement.classList.contains('locked')) return;
            element.parentElement.classList.add('locked');
            
            if (isCorrect) {
                element.classList.add('correct');
                progress += 25; 
                
                if(taskNum === 1) {
                    const reply = document.getElementById('reply-container-1');
                    reply.classList.remove('hidden');
                    reply.classList.add('flex');
                }
                if(taskNum === 2) {
                    const blank = document.getElementById('blank-2');
                    blank.innerText = textValue;
                    blank.classList.remove('border-dashed', 'border-slate-600');
                    blank.classList.add('border-solid', 'border-cyan-400');
                }
                if(taskNum === 4) {
                    document.getElementById('final-fb-4').classList.remove('hidden');
                }
                
                shootConfetti();
                
                setTimeout(() => {
                    goToScreen(taskNum + 1);
                }, 1800);

            } else {
                element.classList.add('wrong', 'shake');
                setTimeout(() => {
                    element.classList.remove('shake');
                    element.parentElement.classList.remove('locked');
                }, 500);
            }
        }

        function resetApp() {
            document.querySelectorAll('.mcq-option').forEach(el => {
                el.classList.remove('correct', 'wrong');
            });
            document.querySelectorAll('.locked').forEach(el => el.classList.remove('locked'));
            
            document.getElementById('reply-container-1').classList.add('hidden');
            document.getElementById('blank-2').innerHTML = "______";
            document.getElementById('blank-2').className = "border-b-2 border-dashed border-slate-600 px-4";
            document.getElementById('final-fb-4').classList.add('hidden');
            
            goToScreen(0);
        }

        // -- Confetti Canvas (Tech style) --
        function shootConfetti() {
            const canvas = document.getElementById('confetti-canvas');
            const ctx = canvas.getContext('2d');
            const parent = canvas.parentElement;
            canvas.width = parent.clientWidth;
            canvas.height = parent.clientHeight;
            
            const pieces = [];
            const colors = ['#06B6D4', '#A855F7', '#FFFFFF', '#1e293b'];
            
            for(let i=0; i<40; i++) {
                pieces.push({
                    x: canvas.width / 2,
                    y: canvas.height / 2,
                    vx: (Math.random() - 0.5) * 16,
                    vy: (Math.random() - 1) * 16 - 2,
                    size: Math.random() * 6 + 2,
                    color: colors[Math.floor(Math.random() * colors.length)],
                    rot: Math.random() * 360,
                    rotSpeed: (Math.random() - 0.5) * 12
                });
            }
            
            let animationId;
            function animate() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                let active = false;
                
                pieces.forEach(p => {
                    p.x += p.vx;
                    p.y += p.vy;
                    p.vy += 0.35; 
                    p.rot += p.rotSpeed;
                    
                    if(p.y < canvas.height) active = true;
                    
                    ctx.save();
                    ctx.translate(p.x, p.y);
                    ctx.rotate(p.rot * Math.PI / 180);
                    ctx.fillStyle = p.color;
                    ctx.shadowBlur = 8;
                    ctx.shadowColor = p.color;
                    // Draw squares for tech feel
                    ctx.fillRect(-p.size/2, -p.size/2, p.size, p.size);
                    ctx.restore();
                });
                
                if(active) animationId = requestAnimationFrame(animate);
                else ctx.clearRect(0, 0, canvas.width, canvas.height);
            }
            animate();
        }
    </script>
</body>
