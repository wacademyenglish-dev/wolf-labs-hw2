                    <div class="w-32 h-32 rounded-full bg-[var(--accent-cyan)]/10 flex items-center justify-center text-6xl text-[var(--accent-cyan)] mb-10 shadow-[0_0_50px_rgba(6,182,212,0.3)] border border-[var(--accent-cyan)]/30" style="animation: popIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;">
